<UserControl
    x:Class="AStation_Client.Controls.VideoCardControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 宽度不写死：由父容器（UniformGridLayout）拉伸决定，避免右侧留下大片空隙 -->
    <Grid
        x:Name="RootGrid"
        HorizontalAlignment="Stretch"
        AutomationProperties.Name="{x:Bind Title, Mode=OneWay}"
        SizeChanged="RootGrid_SizeChanged"
        Tapped="RootGrid_Tapped">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="ThumbnailRow" Height="135" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 缩略图 + 时长（Rectangle + ImageBrush 实现圆角裁剪） -->
        <Border Grid.Row="0" Background="{StaticResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
            <Grid>
                <Rectangle RadiusX="8" RadiusY="8">
                    <Rectangle.Fill>
                        <ImageBrush ImageSource="{x:Bind Thumbnail, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                    </Rectangle.Fill>
                </Rectangle>
                <Border
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Right"
                    Margin="6"
                    Background="#CC000000"
                    CornerRadius="4"
                    Padding="4,2"
                    Visibility="{x:Bind Duration, Mode=OneWay, Converter={StaticResource ObjectToVisibilityConverter}}">
                    <TextBlock
                        Text="{x:Bind Duration, Mode=OneWay}"
                        Foreground="White"
                        FontSize="12"
                        FontWeight="SemiBold" />
                </Border>
            </Grid>
        </Border>

        <!-- 标题 -->
        <TextBlock
            Grid.Row="1"
            Text="{x:Bind Title, Mode=OneWay}"
            Style="{StaticResource BodyStrongTextBlockStyle}"
            MaxLines="2"
            TextTrimming="CharacterEllipsis"
            TextWrapping="Wrap"
            Margin="0,8,0,4" />

        <!-- 作者 + 观看数 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6">
            <TextBlock
                Text="{x:Bind Author, Mode=OneWay}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{StaticResource TextFillColorSecondaryBrush}"
                TextTrimming="CharacterEllipsis"
                MaxWidth="150" />
            <TextBlock Text="·" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{StaticResource TextFillColorSecondaryBrush}" />
            <TextBlock
                Text="{x:Bind ViewCount, Mode=OneWay}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{StaticResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </Grid>
</UserControl>
