<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AStation_Client.Controls.StatePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        统一三态面板：Loading / Empty / Error
        设计为叠在内容区之上（Grid 覆盖），不参与布局，因此显示/隐藏不会推动内容。
        用法：
            <controls:StatePanel x:Name="State" />
            State.ShowLoading(); State.ShowEmpty("还没有内容"); State.ShowError("加载失败", "…", "重试"); State.Hide();
    -->
    <Grid
        x:Name="Root"
        Background="{ThemeResource LayerFillColorDefaultBrush}"
        Visibility="Collapsed">

        <StackPanel
            x:Name="ContentStack"
            MaxWidth="380"
            Margin="24"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8">

            <ProgressRing
                x:Name="Ring"
                Width="28"
                Height="28"
                Margin="0,0,0,4"
                HorizontalAlignment="Center"
                IsActive="False"
                Visibility="Collapsed" />

            <FontIcon
                x:Name="StateIcon"
                Margin="0,0,0,4"
                HorizontalAlignment="Center"
                FontSize="26"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Glyph="&#xE7BA;"
                Visibility="Collapsed" />

            <TextBlock
                x:Name="TitleText"
                HorizontalAlignment="Center"
                FontSize="16"
                FontWeight="SemiBold"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                TextAlignment="Center"
                TextWrapping="Wrap" />

            <TextBlock
                x:Name="DescText"
                HorizontalAlignment="Center"
                FontSize="13"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextAlignment="Center"
                TextWrapping="Wrap"
                Visibility="Collapsed" />

            <Button
                x:Name="ActionButton"
                Margin="0,8,0,0"
                HorizontalAlignment="Center"
                Click="ActionButton_Click"
                Content="重试"
                Style="{StaticResource AppButtonStyle}"
                Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</UserControl>
