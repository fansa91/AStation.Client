<?xml version="1.0" encoding="utf-8"?>
<!--
    设计令牌：间距 / 圆角 / 字号层级 / 语义颜色
    规范基线（与 docs/ui-layout-plan.md §5 一致）
      - 断点 <900 / 900-1200 / 1200-1600 / >=1600
      - 页面边距 24（窄 16）、区块 24、卡片 16、卡内 12
      - 字号 页面标题 28 / 区块 20 / 卡片标题 14 / 元信息 12 / 徽标 11
      - 圆角 卡片 8 / 按钮 4 / 芯片 16 / 播放器 10（全屏 0）
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <!-- 覆盖层遮罩：让打开搜索 / 登录时下方内容明确退后 -->
            <SolidColorBrush x:Key="AppScrimBrush" Color="#4D000000" />
            <!-- 播放器承载面：全屏时用纯黑，窗口模式也保持中性 -->
            <SolidColorBrush x:Key="PlayerBackdropBrush" Color="#FF000000" />
            <!-- 播放页页面底色（Mica 不可用时的兜底） -->
            <SolidColorBrush x:Key="PageBackdropBrush" Color="#F3F3F3" />
            <!-- 播放器内浮层的实心底：压在亮画面上也不能透 -->
            <SolidColorBrush x:Key="PlayerFlyoutBackgroundBrush" Color="#F2F2F2" />
            <!-- 弹幕 / 画中文字 -->
            <SolidColorBrush x:Key="PlayerOnMediaForegroundBrush" Color="#FFFFFFFF" />
            <!-- 导航选中指示 -->
            <SolidColorBrush x:Key="AppNavItemForeground" Color="#1A1A1A" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="AppScrimBrush" Color="#66000000" />
            <SolidColorBrush x:Key="PlayerBackdropBrush" Color="#FF000000" />
            <SolidColorBrush x:Key="PageBackdropBrush" Color="#202020" />
            <SolidColorBrush x:Key="PlayerFlyoutBackgroundBrush" Color="#F21C1C1C" />
            <SolidColorBrush x:Key="PlayerOnMediaForegroundBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="AppNavItemForeground" Color="#EAEAEA" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- ── 间距 ── -->
    <x:Double x:Key="SpaceXxs">4</x:Double>
    <x:Double x:Key="SpaceXs">8</x:Double>
    <x:Double x:Key="SpaceS">12</x:Double>
    <x:Double x:Key="SpaceM">16</x:Double>
    <x:Double x:Key="SpaceL">24</x:Double>
    <x:Double x:Key="SpaceXl">32</x:Double>

    <Thickness x:Key="PagePadding">24,20,24,24</Thickness>
    <Thickness x:Key="PagePaddingNarrow">16,16,16,20</Thickness>
    <Thickness x:Key="SectionSpacing">0</Thickness>
    <Thickness x:Key="CardPadding">12</Thickness>

    <!-- ── 圆角 ── -->
    <CornerRadius x:Key="RadiusCard">8</CornerRadius>
    <CornerRadius x:Key="RadiusButton">4</CornerRadius>
    <CornerRadius x:Key="RadiusChip">16</CornerRadius>
    <CornerRadius x:Key="RadiusPlayer">10</CornerRadius>

    <!-- ── 尺寸 ── -->
    <x:Double x:Key="AppTitleBarHeight">48</x:Double>
    <x:Double x:Key="AppNavOpenWidth">240</x:Double>
    <x:Double x:Key="AppNavCompactWidth">48</x:Double>
    <x:Double x:Key="AppNavViewMinWidth">240</x:Double>
    <x:Double x:Key="AppMaxPageWidth">1600</x:Double>
    <x:Double x:Key="AppMaxPageWidthWide">1920</x:Double>

    <!-- ── 字号层级 ── -->
    <Style x:Key="PageTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SectionTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="GroupCaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="CardTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="MaxLines" Value="2" />
        <Setter Property="LineHeight" Value="20" />
    </Style>

    <Style x:Key="CardTitleSingleLineTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="MaxLines" Value="1" />
    </Style>

    <Style x:Key="MetaTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="MaxLines" Value="1" />
    </Style>

    <Style x:Key="BadgeTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="MaxLines" Value="1" />
    </Style>

    <Style x:Key="BodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="CaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="MaxLines" Value="1" />
    </Style>

</ResourceDictionary>
