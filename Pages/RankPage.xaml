<Page
    x:Class="AStation_Client.Pages.RankPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:AStation_Client.Controls"
    xmlns:models="using:AStation_Client.Models"
    mc:Ignorable="d">

    <Grid Padding="24,16,24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题行 -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Style="{StaticResource PageTitleTextStyle}" Text="排行榜" />
            <Button
                Grid.Column="1"
                Content="刷新"
                VerticalAlignment="Center"
                Style="{StaticResource AppButtonStyle}"
                Click="RefreshButton_Click" />
        </Grid>

        <!-- 当前榜单说明 -->
        <StackPanel Grid.Row="1" Spacing="4">
            <TextBlock x:Name="SectionTitle" Text="全站 · 日榜" Style="{StaticResource SectionTitleTextStyle}" />
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ProgressRing
                    x:Name="LoadingRing"
                    Grid.Column="0"
                    Width="14"
                    Height="14"
                    IsActive="False"
                    Visibility="Collapsed"
                    VerticalAlignment="Center" />
                <TextBlock
                    Grid.Column="1"
                    x:Name="HintText"
                    Style="{StaticResource MetaTextStyle}"
                    Foreground="{StaticResource TextFillColorSecondaryBrush}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </StackPanel>

        <!-- 周期筛选：DAY / THREE_DAYS / WEEK -->
        <StackPanel
            Grid.Row="2"
            x:Name="PeriodPanel"
            Orientation="Horizontal"
            Spacing="8" />

        <!-- 频道筛选：0 = 全站 -->
        <ScrollViewer
            Grid.Row="3"
            HorizontalScrollBarVisibility="Hidden"
            HorizontalScrollMode="Enabled"
            VerticalScrollMode="Disabled"
            VerticalScrollBarVisibility="Disabled">
            <StackPanel
                x:Name="ChannelPanel"
                Orientation="Horizontal"
                Spacing="8" />
        </ScrollViewer>

        <!-- 榜单：行高统一 76，标题 2 行 + 作者/频道/互动一行，x:Bind 编译期绑定 -->
        <Grid Grid.Row="4">
        <ListView
            x:Name="RankList"
            Grid.Row="4"
            IsItemClickEnabled="True"
            ItemClick="RankList_ItemClick"
            ItemContainerStyle="{StaticResource ListViewItemCardStyle}"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:RankEntry">
                    <Grid
                        Height="76"
                        Padding="4,0,8,0"
                        ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 名次徽章 -->
                        <Border
                            Width="28"
                            Height="28"
                            VerticalAlignment="Center"
                            Background="{x:Bind RankText, Converter={StaticResource RankBrushConverter}}"
                            CornerRadius="14">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{x:Bind RankText, Converter={StaticResource RankBrushConverter}, ConverterParameter=Foreground}"
                                Text="{x:Bind RankText}" />
                        </Border>

                        <!-- 缩略图 16:9 -->
                        <Grid
                            Grid.Column="1"
                            Width="112"
                            Height="63"
                            VerticalAlignment="Center"
                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                            CornerRadius="6">
                            <Rectangle RadiusX="6" RadiusY="6">
                                <Rectangle.Fill>
                                    <ImageBrush
                                        ImageSource="{x:Bind Cover, Converter={StaticResource StringToImageSourceConverter}}"
                                        Stretch="UniformToFill" />
                                </Rectangle.Fill>
                            </Rectangle>
                            <Border
                                Margin="0,0,4,4"
                                Padding="5,1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Background="#99000000"
                                CornerRadius="3">
                                <TextBlock
                                    FontSize="10"
                                    Foreground="White"
                                    Text="{x:Bind DurationText}" />
                            </Border>
                        </Grid>

                        <!-- 文本信息 -->
                        <StackPanel
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Spacing="3">
                            <TextBlock
                                FontSize="14"
                                FontWeight="SemiBold"
                                MaxLines="2"
                                Text="{x:Bind Title}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock
                                    Style="{StaticResource MetaTextStyle}"
                                    Text="{x:Bind Author}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Style="{StaticResource MetaTextStyle}"
                                    Text="·" />
                                <TextBlock
                                    Style="{StaticResource MetaTextStyle}"
                                    Text="{x:Bind MetaText}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

            <!-- 加载 / 空 / 失败统一三态 -->
            <controls:StatePanel
                x:Name="RankState"
                ActionClick="RankState_ActionClick" />
        </Grid>
    </Grid>
</Page>
