<Page
    x:Class="AStation_Client.Pages.LivePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:AStation_Client.Models"
    mc:Ignorable="d">

    <Grid Padding="24,16,24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题行 -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Style="{StaticResource TitleTextBlockStyle}" Text="直播" />
            <Button
                Grid.Column="1"
                Content="刷新"
                VerticalAlignment="Center"
                Style="{StaticResource AppButtonStyle}"
                Click="RefreshButton_Click" />
        </Grid>

        <!-- 副标题 + 统计提示 -->
        <StackPanel Grid.Row="1" Spacing="4">
            <TextBlock x:Name="SectionTitle" Text="正在直播" Style="{StaticResource SubtitleTextBlockStyle}" />
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ProgressRing
                    x:Name="LoadingRing"
                    Grid.Column="0"
                    Width="14"
                    Height="14"
                    IsActive="False"
                    Visibility="Collapsed"
                    VerticalAlignment="Center" />
                <TextBlock
                    Grid.Column="1"
                    x:Name="HintText"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{StaticResource TextFillColorSecondaryBrush}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </StackPanel>

        <!-- 分类筛选（真实标签来自 live.acfun.cn/api/channel/list 的 channelFilters） -->
        <ScrollViewer
            Grid.Row="2"
            HorizontalScrollBarVisibility="Hidden"
            HorizontalScrollMode="Enabled"
            VerticalScrollMode="Disabled"
            VerticalScrollBarVisibility="Disabled">
            <StackPanel
                x:Name="CategoryPanel"
                Orientation="Horizontal"
                Spacing="8" />
        </ScrollViewer>

        <!-- 直播卡片流 -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
            <ItemsRepeater x:Name="LiveList">
                <ItemsRepeater.Layout>
                    <UniformGridLayout
                        MinItemWidth="170"
                        MinItemHeight="180"
                        MinColumnSpacing="16"
                        MinRowSpacing="16"
                        ItemsStretch="Fill" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="models:LiveItem">
                        <!-- Tag 直接绑数据对象：ItemsRepeater + x:Bind 的模板不会给根元素设置 DataContext -->
                        <Grid Background="Transparent" Tag="{x:Bind}" Tapped="LiveCard_Tapped">
                            <StackPanel>
                                <!-- 封面 + 在线人数浮层 -->
                                <Grid Height="112">
                                    <Border
                                        CornerRadius="8,8,0,0"
                                        Background="{StaticResource ControlFillColorSecondaryBrush}">
                                        <Image
                                            Source="{x:Bind Cover, Converter={StaticResource StringToImageSourceConverter}}"
                                            Stretch="UniformToFill" />
                                    </Border>
                                    <Border
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="0,8,8,0"
                                        Padding="6,2"
                                        CornerRadius="4"
                                        Background="#99000000">
                                        <TextBlock
                                            Text="{x:Bind OnlineText}"
                                            FontSize="11"
                                            Foreground="White" />
                                    </Border>
                                    <Border
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Bottom"
                                        Margin="8,0,0,8"
                                        Padding="6,2"
                                        CornerRadius="4"
                                        Background="#99000000"
                                        Visibility="{x:Bind Tag, Converter={StaticResource ObjectToVisibilityConverter}}">
                                        <TextBlock
                                            Text="{x:Bind Tag}"
                                            FontSize="11"
                                            Foreground="White" />
                                    </Border>
                                </Grid>

                                <!-- 标题与主播 -->
                                <StackPanel Padding="2,8,2,0" Spacing="4">
                                    <TextBlock
                                        Text="{x:Bind Title}"
                                        Style="{StaticResource BodyTextBlockStyle}"
                                        TextWrapping="Wrap"
                                        MaxLines="2"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Text="{x:Bind Author}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{StaticResource TextFillColorSecondaryBrush}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>
    </Grid>
</Page>
