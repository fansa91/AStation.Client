<Page
    x:Class="AStation_Client.Pages.UserPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AStation_Client.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="using:AStation_Client.Services"
    mc:Ignorable="d">

    <!--
        我的空间（主框架里的独立页面，带后退栈）：
        上半部分账号卡（头像 / 昵称 / 投稿获赞关注粉丝 / uid），
        下半部分「播放历史 / 收藏」两个分页。
        收藏按视频 / 番剧 / 专辑 / 文章四个分类取，接口走 App 基址，需登录。
    -->
    <Grid Padding="{StaticResource PagePadding}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ── 账号卡：渐变横幅 + 头像 + 昵称 / uid / 退出 ── -->
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="104" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Background="{StaticResource AccountBannerBrush}"
                CornerRadius="{StaticResource RadiusCard}" />

            <Grid
                Grid.Row="1"
                Margin="24,-40,0,0"
                RequestedTheme="Light">
                <PersonPicture
                    x:Name="Avatar"
                    Width="80"
                    Height="80"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    BorderBrush="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderThickness="3" />
            </Grid>

            <Grid
                Grid.Row="1"
                Margin="124,10,0,0"
                ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="3">
                    <TextBlock
                        x:Name="UserNameText"
                        Style="{StaticResource SectionTitleTextStyle}"
                        Text="未登录"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="UserStatsText"
                        Style="{StaticResource MetaTextStyle}"
                        Visibility="Collapsed" />
                    <TextBlock
                        x:Name="UserMetaText"
                        Style="{StaticResource MetaTextStyle}"
                        Text="登录后可以查看播放历史与收藏"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        x:Name="LoginButton"
                        AutomationProperties.Name="去登录"
                        Click="LoginButton_Click"
                        Style="{StaticResource AccentButtonStyle}"
                        Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="12" Glyph="&#xE77B;" />
                            <TextBlock FontSize="13" Text="去登录" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="LogoutButton"
                        AutomationProperties.Name="退出登录"
                        Click="LogoutButton_Click"
                        Style="{StaticResource AppButtonStyle}"
                        Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="12" Glyph="&#xE7E8;" />
                            <TextBlock FontSize="13" Text="退出登录" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ── 分页 ── -->
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ToggleButton
                x:Name="HistoryTab"
                Grid.Column="0"
                AutomationProperties.Name="播放历史"
                Click="Tab_Click"
                Content="播放历史"
                IsChecked="True"
                Style="{StaticResource SegmentTabButtonStyle}" />

            <ToggleButton
                x:Name="CollectTab"
                Grid.Column="1"
                AutomationProperties.Name="收藏"
                Click="Tab_Click"
                Content="收藏"
                Style="{StaticResource SegmentTabButtonStyle}" />

            <TextBlock
                x:Name="CountText"
                Grid.Column="3"
                VerticalAlignment="Center"
                Style="{StaticResource MetaTextStyle}" />
        </Grid>

        <!-- ── 内容 ── -->
        <Grid Grid.Row="2">
            <!-- 播放历史 -->
            <Grid x:Name="HistoryPanel">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ListView
                    x:Name="HistoryList"
                    Grid.Row="0"
                    IsItemClickEnabled="True"
                    ItemClick="HistoryList_ItemClick"
                    ItemContainerStyle="{StaticResource ListViewItemCardStyle}"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="services:HistoryItem">
                            <Grid
                                Height="76"
                                Padding="4,0,8,0"
                                ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- 封面 16:9 + 底部进度条 -->
                                <Grid
                                    Grid.Column="0"
                                    Width="112"
                                    Height="63"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                    CornerRadius="6">
                                    <Rectangle RadiusX="6" RadiusY="6">
                                        <Rectangle.Fill>
                                            <ImageBrush
                                                ImageSource="{x:Bind Cover, Converter={StaticResource StringToImageSourceConverter}}"
                                                Stretch="UniformToFill" />
                                        </Rectangle.Fill>
                                    </Rectangle>

                                    <Border
                                        Margin="0,0,4,4"
                                        Padding="5,1"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Background="#99000000"
                                        CornerRadius="3">
                                        <TextBlock
                                            FontSize="10"
                                            Foreground="White"
                                            Text="{x:Bind DurationText}" />
                                    </Border>

                                    <ProgressBar
                                        Height="3"
                                        Margin="0,0,0,0"
                                        VerticalAlignment="Bottom"
                                        Maximum="100"
                                        Value="{x:Bind ProgressPercent}"
                                        Visibility="{x:Bind HasProgress}" />
                                </Grid>

                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="4">
                                    <TextBlock
                                        MaxLines="2"
                                        Style="{StaticResource CardTitleTextStyle}"
                                        Text="{x:Bind Title}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Style="{StaticResource MetaTextStyle}"
                                        Text="{x:Bind MetaText}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <StackPanel
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right"
                                    Spacing="4">
                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource MetaTextStyle}"
                                        Text="{x:Bind ProgressText}" />
                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource MetaTextStyle}"
                                        Text="{x:Bind BrowseTimeText}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Grid
                    Grid.Row="1"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Center">
                    <Button
                        x:Name="LoadMoreButton"
                        AutomationProperties.Name="加载更多"
                        Click="LoadMoreButton_Click"
                        Content="加载更多"
                        Style="{StaticResource AppButtonStyle}"
                        Visibility="Collapsed" />
                    <ProgressRing
                        x:Name="MoreRing"
                        Width="20"
                        Height="20"
                        IsActive="False"
                        Visibility="Collapsed" />
                </Grid>
            </Grid>

            <!-- 收藏：筛选栏常驻，只有列表/空态那一块切换。
                 否则某个分类收藏为空时筛选栏会被一起藏掉，就换不回别的分类了。 -->
            <Grid x:Name="CollectPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 分类筛选：视频 / 番剧 / 专辑 / 文章 -->
                <StackPanel
                    Grid.Row="0"
                    Margin="0,0,0,10"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        x:Name="KindDouga"
                        AutomationProperties.Name="收藏视频"
                        Click="CollectKind_Click"
                        Content="视频"
                        Style="{StaticResource FilterChipSelectedStyle}"
                        Tag="Douga" />
                    <Button
                        x:Name="KindBangumi"
                        AutomationProperties.Name="收藏番剧"
                        Click="CollectKind_Click"
                        Content="番剧"
                        Style="{StaticResource FilterChipStyle}"
                        Tag="Bangumi" />
                    <Button
                        x:Name="KindAlbum"
                        AutomationProperties.Name="收藏专辑"
                        Click="CollectKind_Click"
                        Content="专辑"
                        Style="{StaticResource FilterChipStyle}"
                        Tag="Album" />
                    <Button
                        x:Name="KindArticle"
                        AutomationProperties.Name="收藏文章"
                        Click="CollectKind_Click"
                        Content="文章"
                        Style="{StaticResource FilterChipStyle}"
                        Tag="Article" />
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid x:Name="FavoriteListHost">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ListView
                            x:Name="FavoriteList"
                            Grid.Row="0"
                            IsItemClickEnabled="True"
                            ItemClick="FavoriteList_ItemClick"
                            ItemContainerStyle="{StaticResource ListViewItemCardStyle}"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="services:FavoriteItem">
                                    <Grid
                                        Height="76"
                                        Padding="4,0,8,0"
                                        ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Grid
                                            Grid.Column="0"
                                            Width="112"
                                            Height="63"
                                            VerticalAlignment="Center"
                                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                            CornerRadius="6">
                                            <Rectangle RadiusX="6" RadiusY="6">
                                                <Rectangle.Fill>
                                                    <ImageBrush
                                                        ImageSource="{x:Bind Cover, Converter={StaticResource StringToImageSourceConverter}}"
                                                        Stretch="UniformToFill" />
                                                </Rectangle.Fill>
                                            </Rectangle>

                                            <Border
                                                Margin="0,0,4,4"
                                                Padding="5,1"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom"
                                                Background="#99000000"
                                                CornerRadius="3"
                                                Visibility="{x:Bind HasDuration}">
                                                <TextBlock
                                                    FontSize="10"
                                                    Foreground="White"
                                                    Text="{x:Bind DurationText}" />
                                            </Border>
                                        </Grid>

                                        <StackPanel
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Spacing="4">
                                            <TextBlock
                                                MaxLines="2"
                                                Style="{StaticResource CardTitleTextStyle}"
                                                Text="{x:Bind Title}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                Style="{StaticResource MetaTextStyle}"
                                                Text="{x:Bind MetaText}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <TextBlock
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource MetaTextStyle}"
                                            Text="{x:Bind UpdateText}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <Grid
                            Grid.Row="1"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Center">
                            <Button
                                x:Name="FavoriteMoreButton"
                                AutomationProperties.Name="收藏加载更多"
                                Click="FavoriteMoreButton_Click"
                                Content="加载更多"
                                Style="{StaticResource AppButtonStyle}"
                                Visibility="Collapsed" />
                            <ProgressRing
                                x:Name="FavoriteRing"
                                Width="20"
                                Height="20"
                                IsActive="False"
                                Visibility="Collapsed" />
                        </Grid>
                    </Grid>

                    <controls:StatePanel
                        x:Name="CollectState"
                        ActionClick="CollectState_ActionClick"
                        Visibility="Collapsed" />
                </Grid>
            </Grid>

            <controls:StatePanel
                x:Name="HistoryState"
                ActionClick="HistoryState_ActionClick" />
        </Grid>
    </Grid>
</Page>
