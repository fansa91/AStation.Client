<Page
    x:Class="AStation_Client.Pages.BangumiPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:AStation_Client.Controls"
    xmlns:models="using:AStation_Client.Models"
    mc:Ignorable="d">

    <Grid Padding="24,16,24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题行 -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Style="{StaticResource PageTitleTextStyle}" Text="番剧" />
            <Button
                Grid.Column="1"
                Content="刷新"
                VerticalAlignment="Center"
                Style="{StaticResource AppButtonStyle}"
                Click="RefreshButton_Click" />
        </Grid>

        <!-- 视角切换 + 状态 -->
        <StackPanel Grid.Row="1" Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ToggleButton
                    x:Name="LibraryChip"
                    Content="番剧库"
                    IsChecked="True"
                    MinWidth="0"
                    Padding="16,6,16,6"
                    CornerRadius="16"
                    FontSize="13"
                    Click="ScopeChip_Click" />
                <ToggleButton
                    x:Name="FavoriteChip"
                    Content="我的追番"
                    MinWidth="0"
                    Padding="16,6,16,6"
                    CornerRadius="16"
                    FontSize="13"
                    Click="ScopeChip_Click" />
            </StackPanel>

            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ProgressRing
                    x:Name="LoadingRing"
                    Grid.Column="0"
                    Width="14"
                    Height="14"
                    IsActive="False"
                    Visibility="Collapsed"
                    VerticalAlignment="Center" />
                <TextBlock
                    Grid.Column="1"
                    x:Name="HintText"
                    Style="{StaticResource MetaTextStyle}"
                    Foreground="{StaticResource TextFillColorSecondaryBrush}"
                    Visibility="Collapsed"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </StackPanel>

        <!-- 内容区：网格 or 空状态；列宽交给 UniformGridLayout，不再手算 ItemWidth -->
        <Grid Grid.Row="2">
            <ScrollViewer
                x:Name="BangumiScroll"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Auto">
                <ItemsRepeater x:Name="BangumiList">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            ItemsStretch="Fill"
                            MinColumnSpacing="16"
                            MinItemHeight="302"
                            MinItemWidth="150"
                            MinRowSpacing="16" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:BangumiItem">
                            <controls:MediaCard
                                BottomLeftBadge="{x:Bind EpisodeText}"
                                Click="BangumiCard_Click"
                                Cover="{x:Bind Cover}"
                                CoverAspect="0.75"
                                Payload="{x:Bind}"
                                Title="{x:Bind Title}"
                                TopRightBadge="{x:Bind StatText}" />
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>

            <!-- 空状态：说明真实情况并提供登录入口 -->
            <controls:StatePanel
                x:Name="BangumiState"
                ActionClick="BangumiState_ActionClick" />
        </Grid>
    </Grid>
</Page>
