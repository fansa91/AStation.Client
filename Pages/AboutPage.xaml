<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="AStation_Client.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- 关于：内容限宽居中，窄窗口靠换行吸收，不做横向滚动 -->
    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled"
        VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="920"
            Padding="{StaticResource PagePadding}"
            HorizontalAlignment="Stretch"
            Spacing="20">

            <!-- 应用信息 -->
            <StackPanel
                x:Name="HeaderPanel"
                Orientation="Horizontal"
                Spacing="14">
                <Image
                    Width="56"
                    Height="56"
                    Source="ms-appx:///Assets/StoreLogo.png" />
                <StackPanel VerticalAlignment="Center" Spacing="3">
                    <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="AStation" />
                    <TextBlock
                        x:Name="VersionText"
                        Style="{StaticResource MetaTextStyle}"
                        Text="版本 0.1.0" />
                </StackPanel>
            </StackPanel>

            <TextBlock
                Style="{StaticResource BodyTextStyle}"
                Text="AcFun 第三方桌面客户端：首页推荐、频道、排行榜、番剧、直播与点播播放都在一个窗口里。"
                TextWrapping="Wrap" />

            <!-- 技术栈 -->
            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="技术栈" />
                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusCard}">
                    <Grid ColumnSpacing="12" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Style="{StaticResource GroupCaptionTextStyle}" Text="界面" />
                        <TextBlock
                            Grid.Column="1"
                            Style="{StaticResource CaptionTextStyle}"
                            Text="WinUI 3 / Windows App SDK，Fluent Design 视觉规范"
                            TextWrapping="Wrap" />

                        <TextBlock
                            Grid.Row="1"
                            Style="{StaticResource GroupCaptionTextStyle}"
                            Text="运行时" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="1"
                            Style="{StaticResource CaptionTextStyle}"
                            Text=".NET 10，非打包（unpackaged）部署"
                            TextWrapping="Wrap" />

                        <TextBlock
                            Grid.Row="2"
                            Style="{StaticResource GroupCaptionTextStyle}"
                            Text="播放" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="1"
                            Style="{StaticResource CaptionTextStyle}"
                            Text="HLS 经本地代理转发，FLV 直播由 FFmpegInteropX 解码"
                            TextWrapping="Wrap" />

                        <TextBlock
                            Grid.Row="3"
                            Style="{StaticResource GroupCaptionTextStyle}"
                            Text="数据来源" />
                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="1"
                            Style="{StaticResource CaptionTextStyle}"
                            Text="AcFun 站点公开接口；本应用与 AcFun 官方无关，内容版权归原作者"
                            TextWrapping="Wrap" />
                    </Grid>
                </Border>
            </StackPanel>

            <!-- 链接 -->
            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="链接" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Click="RepoButton_Click" Style="{StaticResource AppButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="12" Glyph="&#xE8B7;" />
                            <TextBlock FontSize="13" Text="项目主页" />
                        </StackPanel>
                    </Button>
                    <Button Click="IssuesButton_Click" Style="{StaticResource AppButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="12" Glyph="&#xE72C;" />
                            <TextBlock FontSize="13" Text="反馈问题" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>

            <TextBlock
                Style="{StaticResource CaptionTextStyle}"
                Text="本应用仅用于学习与个人使用，接口随时可能变化。"
                TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
