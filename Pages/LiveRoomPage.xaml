<Page
    x:Class="AStation_Client.Pages.LiveRoomPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Grid Background="{StaticResource AppShellAcrylicBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部：返回 + 房间标题 -->
        <Grid Padding="20,4,20,10" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button
                x:Name="BackButton"
                Width="34"
                Height="34"
                Click="BackButton_Click"
                Style="{StaticResource AppButtonStyle}"
                ToolTipService.ToolTip="返回直播列表">
                <FontIcon FontSize="14" Glyph="&#xE72B;" />
            </Button>

            <TextBlock
                x:Name="HeaderTitle"
                Grid.Column="1"
                VerticalAlignment="Center"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="直播间"
                TextTrimming="CharacterEllipsis" />
        </Grid>

        <!-- 内容：播放器 + 房间信息 -->
        <Grid Grid.Row="1" Padding="20,0,20,20" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="288" />
            </Grid.ColumnDefinitions>

            <ScrollViewer
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollMode="Disabled"
                HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="12">

                    <!-- 播放器 -->
                    <Grid
                        x:Name="PlayerHost"
                        Background="Black"
                        CornerRadius="10"
                        SizeChanged="PlayerHost_SizeChanged">
                        <MediaPlayerElement
                            x:Name="Player"
                            AreTransportControlsEnabled="True"
                            AutoPlay="True"
                            Stretch="Uniform" />

                        <!-- 顶部左上：直播标识 -->
                        <Border
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="12"
                            Padding="8,3"
                            Background="#CCF0483E"
                            CornerRadius="4">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <Ellipse
                                    Width="6"
                                    Height="6"
                                    VerticalAlignment="Center"
                                    Fill="White" />
                                <TextBlock
                                    FontSize="11"
                                    Foreground="White"
                                    Text="LIVE" />
                            </StackPanel>
                        </Border>

                        <!-- 右上：码率档位 -->
                        <ComboBox
                            x:Name="QualityBox"
                            MinWidth="112"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,12,12,0"
                            PlaceholderText="画质"
                            SelectionChanged="QualityBox_SelectionChanged" />

                        <!-- 加载 / 状态 -->
                        <StackPanel
                            x:Name="StatusPanel"
                            MaxWidth="440"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="10">
                            <ProgressRing
                                x:Name="LoadingRing"
                                Width="28"
                                Height="28"
                                Foreground="White"
                                IsActive="True" />
                            <TextBlock
                                x:Name="StatusText"
                                Foreground="White"
                                Text="正在获取直播流…"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>

                    <!-- 房间标题 + 数据 -->
                    <TextBlock
                        x:Name="TitleText"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="正在加载…"
                        TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border
                            Background="{StaticResource ControlFillColorSecondaryBrush}"
                            CornerRadius="14"
                            Padding="10,4">
                            <TextBlock x:Name="OnlineText" FontSize="12" Text="在线 --" />
                        </Border>
                        <Border
                            x:Name="CategoryBadge"
                            Background="{StaticResource ControlFillColorSecondaryBrush}"
                            CornerRadius="14"
                            Padding="10,4"
                            Visibility="Collapsed">
                            <TextBlock x:Name="CategoryText" FontSize="12" />
                        </Border>
                        <Border
                            Background="{StaticResource ControlFillColorSecondaryBrush}"
                            CornerRadius="14"
                            Padding="10,4">
                            <TextBlock x:Name="DecoderText" FontSize="12" Text="FFmpegInteropX · FLV" />
                        </Border>
                    </StackPanel>

                    <!-- 主播卡片 -->
                    <Border
                        Background="{StaticResource ControlFillColorSecondaryBrush}"
                        CornerRadius="8"
                        Padding="14">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <PersonPicture x:Name="Avatar" Width="44" Height="44" />
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="2">
                                <TextBlock x:Name="AuthorText" Style="{StaticResource BodyStrongTextBlockStyle}" Text="主播" />
                                <TextBlock
                                    x:Name="StreamInfoText"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{StaticResource TextFillColorSecondaryBrush}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 右侧：直播间信息 -->
            <Border
                Grid.Column="1"
                Background="{StaticResource ControlFillColorSecondaryBrush}"
                CornerRadius="8"
                Padding="14"
                VerticalAlignment="Top">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="房间信息" />

                    <StackPanel Spacing="6">
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{StaticResource TextFillColorSecondaryBrush}" Text="主播 UID" />
                        <TextBlock x:Name="AuthorIdText" FontSize="12" IsTextSelectionEnabled="True" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{StaticResource TextFillColorSecondaryBrush}" Text="直播 ID" />
                        <TextBlock x:Name="LiveIdText" FontSize="12" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{StaticResource TextFillColorSecondaryBrush}" Text="流名称" />
                        <TextBlock x:Name="StreamNameText" FontSize="12" IsTextSelectionEnabled="True" TextWrapping="Wrap" Text="--" />
                    </StackPanel>

                    <Rectangle Height="1" Fill="{StaticResource ControlStrokeColorDefaultBrush}" />

                    <TextBlock
                        Foreground="{StaticResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="直播弹幕走 protobuf 实时通道（kuaishou.zt.live.interactive），当前版本只做拉流播放；如果需要实时弹幕与送礼，需要再接入该二进制通道。"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
