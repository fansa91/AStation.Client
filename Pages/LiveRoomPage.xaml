<?xml version="1.0" encoding="utf-8" ?>
<!--
    直播间播放页：骨架与点播页完全一致
      左列 = 统一播放器层（PlayerOverlay 直播形态）+ 房间信息
      右列 = 340 侧栏（直播信息 / 清晰度·线路 / 弹幕）

    播放链路不动：仍然是 LivePlayService 取快手 FLV → FFmpegInteropX → MediaPlayerElement。
-->
<Page
    x:Class="AStation_Client.Pages.LiveRoomPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AStation_Client.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:svc="using:AStation_Client.Services"
    mc:Ignorable="d"
    KeyboardAcceleratorPlacementMode="Hidden">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Escape" Invoked="EscapeAccelerator_Invoked" />
    </Page.KeyboardAccelerators>

    <Page.Resources>
        <DataTemplate x:Key="LiveQualityTemplate" x:DataType="svc:LiveStreamQuality">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    FontSize="13"
                    Text="{x:Bind Name}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="{StaticResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind BitrateText}" />
            </Grid>
        </DataTemplate>

        <!-- 直播信息面板里的键值行 -->
        <Style x:Key="SideKeyTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="SideValueTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="IsTextSelectionEnabled" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Page.Resources>

    <Grid x:Name="PageRoot" Background="{StaticResource AppShellAcrylicBrush}">
        <ScrollViewer
            x:Name="RootScroll"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto">
            <Grid
                x:Name="LayoutGrid"
                Padding="20,4,20,24"
                ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="SideColumn" Width="340" />
                </Grid.ColumnDefinitions>

                <!-- ══════════════ 左：播放器 + 房间信息 ══════════════ -->
                <StackPanel Grid.Column="0" Spacing="12">

                    <!-- 统一播放器层（与点播页共用），直播形态：无进度条 / 无倍速 / 保留音量·清晰度·弹幕·全屏 -->
                    <controls:PlayerOverlay x:Name="Overlay" />

                    <!-- 标题 / 主播 / 房间数据（全屏时整块隐藏） -->
                    <StackPanel x:Name="InfoPanel" Spacing="12">
                        <TextBlock
                            x:Name="TitleText"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="正在加载…"
                            TextWrapping="Wrap" />

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <PersonPicture
                                x:Name="Avatar"
                                Width="40"
                                Height="40"
                                VerticalAlignment="Center" />

                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="2">
                                <TextBlock x:Name="AuthorText" Style="{StaticResource BodyStrongTextBlockStyle}" Text="主播" />
                                <TextBlock
                                    x:Name="MetaText"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{StaticResource TextFillColorSecondaryBrush}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <StackPanel
                                Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Spacing="8">
                                <Border
                                    Padding="10,4"
                                    Background="#33F0483E"
                                    CornerRadius="12">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Ellipse
                                            Width="6"
                                            Height="6"
                                            VerticalAlignment="Center"
                                            Fill="#FFF0483E" />
                                        <TextBlock
                                            x:Name="LiveStateText"
                                            FontSize="12"
                                            Foreground="#FFF0483E"
                                            Text="直播中" />
                                    </StackPanel>
                                </Border>
                                <Border
                                    Padding="10,4"
                                    Background="{StaticResource ControlFillColorSecondaryBrush}"
                                    CornerRadius="12">
                                    <TextBlock
                                        x:Name="OnlineText"
                                        FontSize="12"
                                        Text="在线 --" />
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- 解码 / 拉流方式 -->
                        <Border
                            Background="{StaticResource ControlFillColorSecondaryBrush}"
                            CornerRadius="8"
                            Padding="14">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="3">
                                    <TextBlock x:Name="CategoryText" FontSize="12" Text="分区 --" />
                                    <TextBlock
                                        x:Name="DecoderText"
                                        FontSize="11"
                                        Foreground="{StaticResource TextFillColorSecondaryBrush}"
                                        Text="FFmpegInteropX · FLV" />
                                </StackPanel>
                                <TextBlock
                                    x:Name="StreamNameText"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Foreground="{StaticResource TextFillColorSecondaryBrush}"
                                    MaxWidth="260"
                                    Text="--"
                                    TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- ══════════════ 右：直播信息 / 清晰度·线路 / 弹幕 ══════════════ -->
                <Border
                    x:Name="SidePanel"
                    Grid.Column="1"
                    Padding="12"
                    Background="{StaticResource ControlFillColorSecondaryBrush}"
                    CornerRadius="8"
                    VerticalAlignment="Top">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Name="ListTitle"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="直播信息" />
                            <TextBlock
                                x:Name="ListCountText"
                                Grid.Column="1"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{StaticResource TextFillColorSecondaryBrush}" />
                        </Grid>

                        <!-- 分页切换 -->
                        <Grid Grid.Row="1" ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <ToggleButton
                                x:Name="InfoTab"
                                Grid.Column="0"
                                Padding="0,6"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Click="SideTab_Click"
                                Content="直播信息"
                                CornerRadius="6"
                                FontSize="12"
                                IsChecked="True" />
                            <ToggleButton
                                x:Name="LineTab"
                                Grid.Column="1"
                                Padding="0,6"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Click="SideTab_Click"
                                Content="线路"
                                CornerRadius="6"
                                FontSize="12" />
                            <ToggleButton
                                x:Name="DanmakuTab"
                                Grid.Column="2"
                                Padding="0,6"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Click="SideTab_Click"
                                Content="弹幕"
                                CornerRadius="6"
                                FontSize="12" />
                        </Grid>

                        <!-- 内容区：三个面板叠放，按 tab 显示其一 -->
                        <Grid Grid.Row="2" MinHeight="360">

                            <!-- 直播信息 -->
                            <StackPanel x:Name="InfoPanelContent" Spacing="14">

                                <!-- 主播卡片 -->
                                <Border
                                    Background="{StaticResource ControlFillColorDefaultBrush}"
                                    CornerRadius="8"
                                    Padding="12">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <PersonPicture
                                            x:Name="SideAvatar"
                                            Width="38"
                                            Height="38"
                                            VerticalAlignment="Center" />
                                        <StackPanel
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Spacing="2">
                                            <TextBlock x:Name="SideAuthorText" Style="{StaticResource BodyStrongTextBlockStyle}" Text="主播" />
                                            <TextBlock
                                                x:Name="SideUidText"
                                                FontSize="11"
                                                Foreground="{StaticResource TextFillColorSecondaryBrush}"
                                                Text="UID --" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <StackPanel Spacing="6">
                                    <TextBlock Style="{StaticResource SideKeyTextStyle}" Text="在线人数" />
                                    <TextBlock x:Name="SideOnlineText" Style="{StaticResource SideValueTextStyle}" Text="--" />
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock Style="{StaticResource SideKeyTextStyle}" Text="分区" />
                                    <TextBlock x:Name="SideCategoryText" Style="{StaticResource SideValueTextStyle}" Text="--" />
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock Style="{StaticResource SideKeyTextStyle}" Text="直播 ID" />
                                    <TextBlock x:Name="LiveIdText" Style="{StaticResource SideValueTextStyle}" Text="--" />
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock Style="{StaticResource SideKeyTextStyle}" Text="流名称" />
                                    <TextBlock x:Name="SideStreamText" Style="{StaticResource SideValueTextStyle}" Text="--" />
                                </StackPanel>

                                <Rectangle Height="1" Fill="{StaticResource ControlStrokeColorDefaultBrush}" />

                                <TextBlock
                                    FontSize="11"
                                    Foreground="{StaticResource TextFillColorSecondaryBrush}"
                                    Text="拉流：访客令牌 → getPlayUrls → FLV 直播流，经 FFmpegInteropX 解码后交给系统播放器。"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- 清晰度 / 线路 -->
                            <StackPanel x:Name="LinePanelContent" Spacing="10" Visibility="Collapsed">
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{StaticResource TextFillColorSecondaryBrush}"
                                    Text="同一个直播流的码率档位，切换后重新拉流。卡顿时优先选低码率。"
                                    TextWrapping="Wrap" />
                                <ListView
                                    x:Name="QualityList"
                                    MaxHeight="420"
                                    SelectionMode="Single" />
                            </StackPanel>

                            <!-- 弹幕 -->
                            <StackPanel x:Name="DanmakuPanelContent" Spacing="10" Visibility="Collapsed">
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{StaticResource TextFillColorSecondaryBrush}"
                                    Text="直播弹幕层与开关已经就位，但数据通道（快手 zt.live 的 protobuf 长连接）尚未接入，当前不会显示弹幕。"
                                    TextWrapping="Wrap" />
                                <Rectangle Height="1" Fill="{StaticResource ControlStrokeColorDefaultBrush}" />
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{StaticResource TextFillColorTertiaryBrush}"
                                    Text="接入后可直接复用播放器内的弹幕层，无需改动布局。"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- 空状态 / 提示 -->
                            <TextBlock
                                x:Name="SideEmptyHint"
                                Margin="0,24,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Foreground="{StaticResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                TextAlignment="Center"
                                TextWrapping="Wrap"
                                Visibility="Collapsed" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
