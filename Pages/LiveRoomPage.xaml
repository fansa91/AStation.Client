<?xml version="1.0" encoding="utf-8" ?>
<!--
    直播间播放页：骨架与点播页完全一致
      Row0 播放器（PlayerOverlay 直播形态：单行控制条 / 无进度 / 无倍速）
      Row1 左列 = 房间信息（标题 / 主播 / 在线 / 分区 / 直播 ID / 流名称 / 解码）
           右列 = 清晰度·线路 / 弹幕（两个分页）

    播放链路不动：仍然是 LivePlayService 取快手 FLV → FFmpegInteropX → MediaPlayerElement。
-->
<Page
    x:Class="AStation_Client.Pages.LiveRoomPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AStation_Client.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:svc="using:AStation_Client.Services"
    mc:Ignorable="d"
    KeyboardAcceleratorPlacementMode="Hidden">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Escape" Invoked="EscapeAccelerator_Invoked" />
    </Page.KeyboardAccelerators>

    <Page.Resources>
        <DataTemplate x:Key="LiveQualityTemplate" x:DataType="svc:LiveStreamQuality">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    FontSize="13"
                    Text="{x:Bind Name}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind BitrateText}" />
            </Grid>
        </DataTemplate>

        <Style x:Key="SideKeyTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SideValueTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="IsTextSelectionEnabled" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </Page.Resources>

    <Grid x:Name="PageRoot" Background="Transparent">

        <Border
            x:Name="FullscreenBackdrop"
            Background="{ThemeResource PlayerBackdropBrush}"
            Visibility="Collapsed" />

        <Grid
            x:Name="LayoutGrid"
            Padding="{StaticResource PagePadding}"
            ColumnSpacing="18"
            RowSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="320" />
                <ColumnDefinition x:Name="SideColumn" Width="340" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="PlayerRow" Height="Auto" />
                <RowDefinition x:Name="ContentRow" Height="*" />
            </Grid.RowDefinitions>

            <!-- 统一播放器层（与点播页共用），直播形态 -->
            <controls:PlayerOverlay
                x:Name="Overlay"
                Grid.Row="0"
                Grid.Column="0" />

            <ScrollViewer
                x:Name="BodyScroll"
                Grid.Row="1"
                Grid.Column="0"
                HorizontalContentAlignment="Stretch"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                VerticalContentAlignment="Stretch"
                VerticalScrollBarVisibility="Hidden"
                VerticalScrollMode="Disabled">

                <Grid x:Name="BodyGrid" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition x:Name="StackedRow" Height="0" />
                    </Grid.RowDefinitions>

                    <!-- ═══════════ 左列：房间信息 ═══════════ -->
                    <StackPanel
                        x:Name="MainColumn"
                        Grid.Row="0"
                        Grid.RowSpan="2"
                        Spacing="12">

                        <TextBlock
                            x:Name="TitleText"
                            FontSize="18"
                            FontWeight="SemiBold"
                            MaxLines="2"
                            Text="正在加载…"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap" />

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" MinWidth="120" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <PersonPicture
                                x:Name="Avatar"
                                Width="38"
                                Height="38"
                                VerticalAlignment="Center" />

                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="2">
                                <TextBlock
                                    x:Name="AuthorText"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Text="主播"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="UidText" Style="{StaticResource MetaTextStyle}" Text="UID --" />
                            </StackPanel>

                            <StackPanel
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="6">
                                <!-- 直播状态徽标：底色与文字都用同一个语义色，不再硬编码两处 -->
                                <Border
                                    x:Name="LiveStateBadge"
                                    Padding="10,5"
                                    Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                                    CornerRadius="12">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Ellipse
                                            Width="6"
                                            Height="6"
                                            VerticalAlignment="Center"
                                            Fill="{ThemeResource SystemFillColorCriticalBrush}" />
                                        <TextBlock
                                            x:Name="LiveStateText"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                            Text="直播中" />
                                    </StackPanel>
                                </Border>
                                <Border
                                    Padding="10,5"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                    CornerRadius="12">
                                    <TextBlock
                                        x:Name="OnlineText"
                                        FontSize="12"
                                        Text="在线 --" />
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- 房间详细数据：宽列里横排成两列，窄了就自然换行 -->
                        <Border
                            Padding="14"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusCard}">
                            <Grid ColumnSpacing="24" RowSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Spacing="3">
                                    <TextBlock Style="{StaticResource SideKeyTextStyle}" Text="分区" />
                                    <TextBlock x:Name="CategoryText" Style="{StaticResource SideValueTextStyle}" Text="--" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock Style="{StaticResource SideKeyTextStyle}" Text="直播 ID" />
                                    <TextBlock x:Name="LiveIdText" Style="{StaticResource SideValueTextStyle}" Text="--" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Spacing="3">
                                    <TextBlock Style="{StaticResource SideKeyTextStyle}" Text="流名称" />
                                    <TextBlock x:Name="StreamNameText" Style="{StaticResource SideValueTextStyle}" Text="--" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="3">
                                    <TextBlock Style="{StaticResource SideKeyTextStyle}" Text="解码" />
                                    <TextBlock x:Name="DecoderText" Style="{StaticResource SideValueTextStyle}" Text="FFmpegInteropX · FLV" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="拉流：访客令牌 → getPlayUrls → FLV 直播流，经 FFmpegInteropX 解码后交给系统播放器。切换码率会重新拉流。"
                            TextWrapping="Wrap" />
                    </StackPanel>

                </Grid>
            </ScrollViewer>
            <!-- ═══════════ 右列：线路 / 弹幕 ═══════════ -->
            <Border
                x:Name="SidePanel"
                Grid.Row="0"
                Grid.RowSpan="2"
                Grid.Column="1"
                Padding="12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusCard}">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ToggleButton
                            x:Name="LineTab"
                            AutomationProperties.Name="线路"
                            Click="SideTab_Click"
                            Content="清晰度"
                            IsChecked="True"
                            Style="{StaticResource SegmentTabButtonStyle}" />
                        <ToggleButton
                            x:Name="DanmakuTab"
                            Grid.Column="1"
                            AutomationProperties.Name="弹幕"
                            Click="SideTab_Click"
                            Content="弹幕"
                            Style="{StaticResource SegmentTabButtonStyle}" />
                        <TextBlock
                            x:Name="ListCountText"
                            Grid.Column="3"
                            VerticalAlignment="Center"
                            Style="{StaticResource MetaTextStyle}" />
                    </Grid>

                    <Grid Grid.Row="1">
                        <!-- 码率档位 -->
                        <StackPanel x:Name="LinePanelContent" Spacing="8">
                            <TextBlock
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="同一路直播的码率档位，切换后重新拉流。卡顿时优先选低码率。"
                                TextWrapping="Wrap" />
                            <Grid>
                                <ListView
                                    x:Name="QualityList"
                                    SelectionMode="Single"
                                    ItemContainerStyle="{StaticResource ListViewItemFlushStyle}" />
                                <controls:StatePanel
                                    x:Name="LineState"
                                    ActionClick="LineState_ActionClick" />
                            </Grid>
                        </StackPanel>

                        <!-- 弹幕：通道未接入，用统一状态面板说明 -->
                        <StackPanel
                            x:Name="DanmakuPanelContent"
                            Spacing="8"
                            Visibility="Collapsed">
                            <controls:StatePanel x:Name="DanmakuState" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
