<Page
    x:Class="AStation_Client.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:AStation_Client.Controls"
    xmlns:models="using:AStation_Client.Models"
    xmlns:viewmodels="using:AStation_Client.ViewModels"
    mc:Ignorable="d">

    <Page.DataContext>
        <viewmodels:HomeViewModel x:Name="ViewModel" />
    </Page.DataContext>

    <!--
        首页三段式（整页统一滚动，各段不再自己带滚动条）：
          ① Hero：榜一 1 大卡 + 二~四名 3 小条
          ② 分区入口：常用分区胶囊 + 「全部分区」
          ③ 推荐视频：标题 + 换一批 + 卡片网格
    -->
    <Grid x:Name="PageRoot" Background="Transparent">

        <ScrollViewer
            x:Name="PageScroll"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto">

            <StackPanel
                x:Name="ContentPanel"
                Padding="{StaticResource PagePadding}"
                Spacing="24">

                <!-- ═══════════ ① Hero ═══════════ -->
                <Grid x:Name="HeroGrid" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="HeroSideColumn" Width="300" />
                    </Grid.ColumnDefinitions>

                    <!-- 榜一：封面铺满 + 底部渐变遮罩 + 标题 -->
                    <Grid
                        x:Name="HeroMain"
                        Grid.Column="0"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                        CornerRadius="{StaticResource RadiusPlayer}"
                        Tag="{x:Bind ViewModel.HeroMain.ResourceId, Mode=OneWay}"
                        Tapped="Hero_Click">
                        <Rectangle RadiusX="10" RadiusY="10">
                            <Rectangle.Fill>
                                <ImageBrush
                                    ImageSource="{x:Bind ViewModel.HeroMain.Thumbnail, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}"
                                    Stretch="UniformToFill" />
                            </Rectangle.Fill>
                        </Rectangle>
                        <Rectangle RadiusX="10" RadiusY="10">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                    <GradientStop Offset="0.25" Color="#00000000" />
                                    <GradientStop Offset="1" Color="#D9000000" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>

                        <StackPanel
                            Padding="18"
                            VerticalAlignment="Bottom"
                            Spacing="6">
                            <Border
                                Padding="7,2"
                                HorizontalAlignment="Left"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                CornerRadius="4">
                                <TextBlock
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                    Text="榜一" />
                            </Border>
                            <TextBlock
                                FontSize="22"
                                FontWeight="SemiBold"
                                Foreground="White"
                                MaxLines="2"
                                Text="{x:Bind ViewModel.HeroMain.Title, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap" />
                            <TextBlock
                                FontSize="12"
                                Foreground="#D9FFFFFF"
                                Text="{x:Bind ViewModel.HeroMain.Author, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>

                    <!-- 二~四名：横向小条，三等分撑满 Hero 高度 -->
                    <Grid
                        x:Name="HeroSide"
                        Grid.Column="1"
                        RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid
                            x:Name="HeroRow2"
                            Grid.Row="0"
                            ColumnSpacing="10"
                            Tag="{x:Bind ViewModel.HeroSecond.ResourceId, Mode=OneWay}"
                            Tapped="Hero_Click"
                            Visibility="{x:Bind ViewModel.HeroSecond, Mode=OneWay, Converter={StaticResource ObjectToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="112" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid
                                Height="63"
                                VerticalAlignment="Center"
                                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                CornerRadius="6">
                                <Rectangle RadiusX="6" RadiusY="6">
                                    <Rectangle.Fill>
                                        <ImageBrush
                                            ImageSource="{x:Bind ViewModel.HeroSecond.Thumbnail, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}"
                                            Stretch="UniformToFill" />
                                    </Rectangle.Fill>
                                </Rectangle>
                            </Grid>
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="3">
                                <TextBlock
                                    FontSize="13"
                                    MaxLines="2"
                                    Text="{x:Bind ViewModel.HeroSecond.Title, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Style="{StaticResource MetaTextStyle}"
                                    Text="{x:Bind ViewModel.HeroSecond.Author, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>

                        <Grid
                            Grid.Row="1"
                            ColumnSpacing="10"
                            Tag="{x:Bind ViewModel.HeroThird.ResourceId, Mode=OneWay}"
                            Tapped="Hero_Click"
                            Visibility="{x:Bind ViewModel.HeroThird, Mode=OneWay, Converter={StaticResource ObjectToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="112" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid
                                Height="63"
                                VerticalAlignment="Center"
                                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                CornerRadius="6">
                                <Rectangle RadiusX="6" RadiusY="6">
                                    <Rectangle.Fill>
                                        <ImageBrush
                                            ImageSource="{x:Bind ViewModel.HeroThird.Thumbnail, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}"
                                            Stretch="UniformToFill" />
                                    </Rectangle.Fill>
                                </Rectangle>
                            </Grid>
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="3">
                                <TextBlock
                                    FontSize="13"
                                    MaxLines="2"
                                    Text="{x:Bind ViewModel.HeroThird.Title, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Style="{StaticResource MetaTextStyle}"
                                    Text="{x:Bind ViewModel.HeroThird.Author, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>

                        <Grid
                            Grid.Row="2"
                            ColumnSpacing="10"
                            Tag="{x:Bind ViewModel.HeroFourth.ResourceId, Mode=OneWay}"
                            Tapped="Hero_Click"
                            Visibility="{x:Bind ViewModel.HeroFourth, Mode=OneWay, Converter={StaticResource ObjectToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="112" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid
                                Height="63"
                                VerticalAlignment="Center"
                                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                CornerRadius="6">
                                <Rectangle RadiusX="6" RadiusY="6">
                                    <Rectangle.Fill>
                                        <ImageBrush
                                            ImageSource="{x:Bind ViewModel.HeroFourth.Thumbnail, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}"
                                            Stretch="UniformToFill" />
                                    </Rectangle.Fill>
                                </Rectangle>
                            </Grid>
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="3">
                                <TextBlock
                                    FontSize="13"
                                    MaxLines="2"
                                    Text="{x:Bind ViewModel.HeroFourth.Title, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Style="{StaticResource MetaTextStyle}"
                                    Text="{x:Bind ViewModel.HeroFourth.Author, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- ═══════════ ② 分区入口 ═══════════ -->
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="分区" />
                    <ScrollViewer
                        HorizontalScrollBarVisibility="Hidden"
                        HorizontalScrollMode="Enabled"
                        VerticalScrollMode="Disabled"
                        VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ItemsRepeater x:Name="ChannelStrip" ItemsSource="{x:Bind ViewModel.QuickChannels, Mode=OneWay}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Horizontal" Spacing="8" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="models:ChannelItem">
                                        <Button
                                            MinWidth="0"
                                            Padding="16,7"
                                            Tag="{x:Bind Id}"
                                            Click="ChannelChip_Click"
                                            Content="{x:Bind Name}"
                                            Style="{StaticResource ChipButtonStyle}" />
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>

                            <Button
                                MinWidth="0"
                                Padding="16,7"
                                Click="AllChannels_Click"
                                Style="{StaticResource AppButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock FontSize="13" Text="全部分区" />
                                    <FontIcon FontSize="11" Glyph="&#xE76C;" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </StackPanel>

                <!-- ═══════════ ③ 推荐视频 ═══════════ -->
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource SectionTitleTextStyle}"
                            Text="推荐视频" />
                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="换一批"
                            Click="RefreshVideos_Click"
                            Style="{StaticResource AppButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="12" Glyph="&#xE72C;" />
                                <TextBlock FontSize="13" Text="换一批" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <ItemsRepeater x:Name="VideoList" ItemsSource="{x:Bind ViewModel.Videos, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout
                                ItemsStretch="Fill"
                                MinColumnSpacing="16"
                                MinItemHeight="204"
                                MinItemWidth="196"
                                MinRowSpacing="20" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:VideoItem">
                                <controls:MediaCard
                                    Click="VideoCard_Click"
                                    Cover="{x:Bind Thumbnail}"
                                    Meta="{x:Bind ViewCount}"
                                    Subtitle="{x:Bind Author}"
                                    Payload="{x:Bind ResourceId}"
                                    Title="{x:Bind Title}"
                                    TopRightBadge="{x:Bind Duration}" />
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- 加载 / 失败统一走状态面板，叠在内容上，不顶动页面 -->
        <controls:StatePanel
            x:Name="HomeState"
            ActionClick="HomeState_ActionClick" />
    </Grid>
</Page>
