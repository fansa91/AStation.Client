<Page
    x:Class="AStation_Client.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatible/2006"
    xmlns:controls="using:AStation_Client.Controls"
    xmlns:viewmodels="using:AStation_Client.ViewModels"
    xmlns:models="using:AStation_Client.Models"
>

    <Page.DataContext>
        <viewmodels:HomeViewModel x:Name="ViewModel" />
    </Page.DataContext>

    <Grid Padding="24,16,24,16" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页面标题 -->
        <TextBlock
            Grid.Row="0"
            Style="{StaticResource TitleTextBlockStyle}"
            Text="首页" />

        <!-- 加载中状态 -->
        <StackPanel Grid.Row="1" Spacing="8"
                    Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <ProgressBar IsIndeterminate="True" Width="300" />
            <TextBlock Text="正在加载频道和视频数据……" Style="{StaticResource CaptionTextBlockStyle}" />
        </StackPanel>

        <!-- 错误提示与重试 -->
        <StackPanel Grid.Row="2" Spacing="8"
                    Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource ObjectToVisibilityConverter}}">
            <TextBlock
                Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Foreground="{StaticResource SystemFillColorCriticalBrush}"
                TextWrapping="Wrap" />
            <Button Content="重试" Click="RetryButton_Click"
                    HorizontalAlignment="Left"
                    Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>

        <!-- 频道快捷入口（横向滚动） -->
        <StackPanel Grid.Row="3" Spacing="8">
            <TextBlock Text="频道导航" Style="{StaticResource SubtitleTextBlockStyle}" />
            <ScrollViewer
                HorizontalScrollMode="Auto"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollMode="Disabled"
                VerticalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="ChannelList" ItemsSource="{x:Bind ViewModel.Channels, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" MaxHeight="72" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:ChannelItem">
                            <Button
                                Width="100"
                                Height="56"
                                Margin="0,0,10,0"
                                Content="{x:Bind Name}"
                                Tag="{x:Bind Tag}"
                                Style="{StaticResource ChannelCardButtonStyle}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>

        <!-- 推荐视频卡片流：UniformGridLayout + ItemsStretch=Fill 让卡片均分整行，消除右侧空隙 -->
        <Grid Grid.Row="4" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="推荐视频" Style="{StaticResource SubtitleTextBlockStyle}" />
            <ScrollViewer
                Grid.Row="1"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                <ItemsRepeater x:Name="VideoList" ItemsSource="{x:Bind ViewModel.Videos, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            MinItemWidth="220"
                            MinItemHeight="230"
                            MinColumnSpacing="16"
                            MinRowSpacing="20"
                            ItemsStretch="Fill" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:VideoItem">
                            <controls:VideoCardControl
                                Title="{x:Bind Title}"
                                Author="{x:Bind Author}"
                                ViewCount="{x:Bind ViewCount}"
                                Duration="{x:Bind Duration}"
                                Thumbnail="{x:Bind Thumbnail}"
                                ResourceId="{x:Bind ResourceId}"
                                Click="VideoCard_Click" />
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
