<Page
    x:Class="AStation_Client.Pages.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid
            MaxWidth="900"
            Padding="40,28,40,32"
            ColumnSpacing="32"
            RowSpacing="20"
            HorizontalAlignment="Center"
            VerticalAlignment="Top">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <!-- 页面标题（跨两栏） -->
            <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Spacing="4">
                <TextBlock Text="登录" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock
                    Text="登录后可同步追番、收藏、观看历史，并使用评论与弹幕功能"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{StaticResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <!-- ============ 左：扫码登录 ============ -->
            <StackPanel Grid.Row="1" Grid.Column="0" Spacing="12" VerticalAlignment="Top">
                <TextBlock Text="扫码登录" Style="{StaticResource SubtitleTextBlockStyle}" />

                <Border
                    Width="220"
                    Height="220"
                    HorizontalAlignment="Left"
                    Padding="10"
                    CornerRadius="12"
                    Background="{StaticResource CardBackgroundFillColorDefaultBrush}">
                    <Grid>
                        <Image
                            x:Name="QrCodeImage"
                            Stretch="Uniform"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                        <TextBlock
                            x:Name="QrPlaceholder"
                            Text="加载二维码中…"
                            TextWrapping="Wrap"
                            TextAlignment="Center"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </Border>

                <TextBlock
                    x:Name="QrStatusText"
                    Text="等待扫描…"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextWrapping="Wrap"
                    Foreground="{StaticResource TextFillColorSecondaryBrush}" />

                <TextBlock
                    Text="使用 AcFun 手机客户端扫一扫，在手机上确认即可登录"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{StaticResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button
                        x:Name="RefreshQrButton"
                        Content="刷新二维码"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="RefreshQrButton_Click" />
                    <Button
                        x:Name="CancelQrButton"
                        Content="关闭"
                        Style="{StaticResource AppButtonStyle}"
                        Click="CancelQrButton_Click" />
                </StackPanel>
            </StackPanel>

            <!-- ============ 中间竖分隔线 ============ -->
            <Rectangle
                Grid.Row="1"
                Grid.Column="1"
                Width="1"
                Margin="0,4,0,4"
                Fill="{StaticResource TextFillColorSecondaryBrush}"
                Opacity="0.2" />

            <!-- ============ 右：账号密码登录 ============ -->
            <StackPanel Grid.Row="1" Grid.Column="2" Spacing="12" VerticalAlignment="Top">
                <TextBlock Text="账号密码登录" Style="{StaticResource SubtitleTextBlockStyle}" />

                <TextBox
                    x:Name="UsernameBox"
                    Header="账号"
                    PlaceholderText="手机号 / 邮箱" />
                <PasswordBox
                    x:Name="PasswordBox"
                    Header="密码"
                    PlaceholderText="密码" />

                <!-- 图形验证码（初始隐藏，获取验证码后显示） -->
                <Grid
                    x:Name="CaptchaPanel"
                    Visibility="Collapsed"
                    ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        CornerRadius="4"
                        Background="{StaticResource ControlFillColorSecondaryBrush}">
                        <Image x:Name="CaptchaImage" Width="110" Height="36" Stretch="Fill" />
                    </Border>
                    <TextBox
                        Grid.Column="1"
                        x:Name="CaptchaBox"
                        PlaceholderText="请输入图中字符"
                        VerticalAlignment="Bottom" />
                    <Button
                        Grid.Column="2"
                        x:Name="RefreshCaptchaButton"
                        Content="换一张"
                        VerticalAlignment="Bottom"
                        Style="{StaticResource AppButtonStyle}"
                        Click="RefreshCaptchaButton_Click" />
                </Grid>

                <Button
                    x:Name="SignInButton"
                    Content="登录"
                    Margin="0,4,0,0"
                    HorizontalAlignment="Stretch"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="SignInButton_Click" />

                <TextBlock
                    x:Name="LoginResultText"
                    Visibility="Collapsed"
                    TextWrapping="Wrap"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{StaticResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
