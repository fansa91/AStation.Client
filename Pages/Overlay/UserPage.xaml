<Page
    x:Class="AStation_Client.Pages.Overlay.UserPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AStation_Client.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        用户空间（覆盖层）：有账号信息就先摆好骨架，
        作品列表接口尚未接入，用统一空态说明，不放假数据。
    -->
    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 封面 + 头像 -->
        <Grid Grid.Row="0" Height="132">
            <Border CornerRadius="8,8,0,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="#FF4A90D9" />
                        <GradientStop Offset="1" Color="#FFE45C7B" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <PersonPicture
                x:Name="Avatar"
                Width="78"
                Height="78"
                Margin="24,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                BorderBrush="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderThickness="3" />
        </Grid>

        <!-- 名称 + 状态 + 退出 -->
        <Grid
            Grid.Row="1"
            Padding="24,12,24,16"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center" Spacing="4">
                <TextBlock
                    x:Name="UserNameText"
                    Style="{StaticResource SectionTitleTextStyle}"
                    Text="未登录"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    x:Name="StatusText"
                    Style="{StaticResource MetaTextStyle}"
                    Text="登录后可以查看自己的收藏与追番" />
            </StackPanel>

            <Button
                x:Name="LogoutButton"
                Grid.Column="1"
                VerticalAlignment="Center"
                Click="LogoutButton_Click"
                Style="{StaticResource AppButtonStyle}"
                Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontSize="12" Glyph="&#xE7E8;" />
                    <TextBlock FontSize="13" Text="退出登录" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- 作品区 -->
        <Grid Grid.Row="2">
            <controls:StatePanel x:Name="WorksState" ActionClick="WorksState_ActionClick" />
        </Grid>
    </Grid>
</Page>
