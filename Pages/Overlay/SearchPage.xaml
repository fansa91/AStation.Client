<Page
    x:Class="AStation_Client.Pages.Overlay.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AStation_Client.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:AStation_Client.Models"
    mc:Ignorable="d">

    <!-- 覆盖层里的搜索页：宽度由 OverlayCard 给（最宽 880），这里只做纵向分配 -->
    <Grid
        Padding="24,18,24,18"
        RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="搜索" />

        <AutoSuggestBox
            x:Name="SearchInput"
            Grid.Row="1"
            MaxSuggestionListHeight="260"
            PlaceholderText="搜索视频，回车查看结果"
            QueryIcon="Find"
            QuerySubmitted="SearchInput_QuerySubmitted"
            TextChanged="SearchInput_TextChanged" />

        <!--
            排序 + 结果统计：搜过一次之后才出现。
            接口只下发前 30 条（page/size 被服务端忽略），所以右侧如实写「显示前 N 条」，
            不做「加载更多」——否则只会把第一页重复追加。
        -->
        <Grid
            x:Name="SortBar"
            Grid.Row="2"
            ColumnSpacing="8"
            Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ToggleButton
                x:Name="SortRelevance"
                AutomationProperties.Name="综合排序"
                Click="Sort_Click"
                Content="综合"
                IsChecked="True"
                Style="{StaticResource SegmentTabButtonStyle}" />
            <ToggleButton
                x:Name="SortMostViewed"
                Grid.Column="1"
                AutomationProperties.Name="最多播放"
                Click="Sort_Click"
                Content="最多播放"
                Style="{StaticResource SegmentTabButtonStyle}" />
            <ToggleButton
                x:Name="SortNewest"
                Grid.Column="2"
                AutomationProperties.Name="最新发布"
                Click="Sort_Click"
                Content="最新发布"
                Style="{StaticResource SegmentTabButtonStyle}" />

            <TextBlock
                x:Name="ResultCountText"
                Grid.Column="4"
                VerticalAlignment="Center"
                Style="{StaticResource MetaTextStyle}" />
        </Grid>

        <!-- MinHeight：清空关键词回到初始态时，覆盖层不至于缩成一条窄卡片 -->
        <Grid Grid.Row="3" MinHeight="320">
            <ScrollViewer
                x:Name="ResultScroll"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Auto">
                <ItemsRepeater x:Name="ResultList">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            ItemsStretch="Fill"
                            MinColumnSpacing="12"
                            MinItemHeight="196"
                            MinItemWidth="190"
                            MinRowSpacing="16" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:VideoItem">
                            <controls:MediaCard
                                Click="ResultCard_Click"
                                Cover="{x:Bind Thumbnail}"
                                Meta="{x:Bind ViewCount}"
                                Payload="{x:Bind ResourceId}"
                                Subtitle="{x:Bind Author}"
                                Title="{x:Bind Title}"
                                TopRightBadge="{x:Bind Duration}" />
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>

            <!-- 加载 / 空 / 失败统一三态（不顶动页面布局） -->
            <controls:StatePanel
                x:Name="SearchState"
                ActionClick="SearchState_ActionClick" />

            <!-- 初始态：还没搜过。带最近搜索，避免对着空框发呆 -->
            <Grid
                x:Name="EmptyPanel"
                Background="{ThemeResource LayerFillColorDefaultBrush}">
                <StackPanel
                    MaxWidth="460"
                    Margin="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8">
                    <FontIcon
                        Margin="0,0,0,4"
                        HorizontalAlignment="Center"
                        FontSize="30"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE721;" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        Text="搜索 AcFun 视频"
                        TextAlignment="Center" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="13"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="输入关键词后回车。搜索目前只覆盖视频。"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />

                    <StackPanel
                        x:Name="HistorySection"
                        Margin="0,10,0,0"
                        Spacing="10"
                        Visibility="Collapsed">
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{StaticResource MetaTextStyle}"
                            Text="最近搜索" />
                        <ItemsRepeater x:Name="HistoryChips">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Horizontal" Spacing="8" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate>
                                    <Button
                                        Click="HistoryChip_Click"
                                        Style="{StaticResource ChipButtonStyle}"
                                        Tag="{Binding}">
                                        <TextBlock
                                            MaxWidth="118"
                                            Text="{Binding}"
                                            TextTrimming="CharacterEllipsis" />
                                    </Button>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>
