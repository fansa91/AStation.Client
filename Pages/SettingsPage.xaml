<Page
    x:Class="AStation_Client.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
            <Setter Property="Padding" Value="16,14" />
        </Style>
        <Style x:Key="RowTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="RowDescStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionWrapTextStyle}">
            <Setter Property="Foreground" Value="{StaticResource TextFillColorSecondaryBrush}" />
        </Style>
    </Page.Resources>

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled"
        VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="ContentPanel" Padding="24,8,24,24" Spacing="14" MaxWidth="920" HorizontalAlignment="Stretch">

            <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="设置" />

            <!-- 外观 -->
            <Border Style="{StaticResource SectionCardStyle}">
                <StackPanel Spacing="14">
                    <TextBlock Style="{StaticResource GroupTitleTextStyle}" Text="外观" />

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource RowTitleStyle}" Text="主题" />
                            <TextBlock Style="{StaticResource RowDescStyle}" Text="跟随系统，或手动锁定浅色 / 深色" />
                        </StackPanel>
                        <ComboBox
                            x:Name="ThemeBox"
                            Grid.Column="1"
                            MinWidth="132"
                            SelectionChanged="ThemeBox_SelectionChanged">
                            <ComboBoxItem Content="跟随系统" />
                            <ComboBoxItem Content="浅色" />
                            <ComboBoxItem Content="深色" />
                        </ComboBox>
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource RowTitleStyle}" Text="侧边栏常驻展开" />
                            <TextBlock Style="{StaticResource RowDescStyle}" Text="关闭后侧边栏只显示图标，鼠标悬停再展开" />
                        </StackPanel>
                        <ToggleSwitch
                            x:Name="ExpandSidebarSwitch"
                            Grid.Column="1"
                            OnContent=""
                            OffContent=""
                            Toggled="ExpandSidebarSwitch_Toggled" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 播放 -->
            <Border Style="{StaticResource SectionCardStyle}">
                <StackPanel Spacing="14">
                    <TextBlock Style="{StaticResource GroupTitleTextStyle}" Text="播放" />

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource RowTitleStyle}" Text="默认清晰度" />
                            <TextBlock Style="{StaticResource RowDescStyle}" Text="接口实际提供的档位：1080P / 720P / 540P / 360P" />
                        </StackPanel>
                        <ComboBox
                            x:Name="QualityBox"
                            Grid.Column="1"
                            MinWidth="132"
                            SelectionChanged="QualityBox_SelectionChanged">
                            <ComboBoxItem Content="自动（最高）" />
                            <ComboBoxItem Content="1080P" />
                            <ComboBoxItem Content="720P" />
                            <ComboBoxItem Content="540P" />
                            <ComboBoxItem Content="360P" />
                        </ComboBox>
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource RowTitleStyle}" Text="优先 HEVC（H265）" />
                            <TextBlock Style="{StaticResource RowDescStyle}" Text="接口同时下发 ksPlayJson（H264）与 ksPlayJsonHevc（H265），同清晰度下 H265 更省带宽" />
                        </StackPanel>
                        <ToggleSwitch
                            x:Name="HevcSwitch"
                            Grid.Column="1"
                            OnContent=""
                            OffContent=""
                            Toggled="HevcSwitch_Toggled" />
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource RowTitleStyle}" Text="自动开始播放" />
                            <TextBlock Style="{StaticResource RowDescStyle}" Text="进入播放页拿到流地址后立即播放" />
                        </StackPanel>
                        <ToggleSwitch
                            x:Name="AutoPlaySwitch"
                            Grid.Column="1"
                            OnContent=""
                            OffContent=""
                            Toggled="AutoPlaySwitch_Toggled" />
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource RowTitleStyle}" Text="继续上次播放进度" />
                            <TextBlock Style="{StaticResource RowDescStyle}" Text="服务端返回 userPlayedSeconds 时自动跳转到上次位置" />
                        </StackPanel>
                        <ToggleSwitch
                            x:Name="ResumeSwitch"
                            Grid.Column="1"
                            OnContent=""
                            OffContent=""
                            Toggled="ResumeSwitch_Toggled" />
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource RowTitleStyle}" Text="优先备用 CDN" />
                            <TextBlock Style="{StaticResource RowDescStyle}" Text="每档清晰度都有 tx / ali 双地址，主地址卡顿时自动改用 backupUrl" />
                        </StackPanel>
                        <ToggleSwitch
                            x:Name="BackupCdnSwitch"
                            Grid.Column="1"
                            OnContent=""
                            OffContent=""
                            Toggled="BackupCdnSwitch_Toggled" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 弹幕 -->
            <Border Style="{StaticResource SectionCardStyle}">
                <StackPanel Spacing="14">
                    <TextBlock Style="{StaticResource GroupTitleTextStyle}" Text="弹幕" />

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource RowTitleStyle}" Text="显示弹幕" />
                            <TextBlock Style="{StaticResource RowDescStyle}" Text="弹幕来自 /rest/pc-direct/new-danmaku/list，按分P / 集挂载" />
                        </StackPanel>
                        <ToggleSwitch
                            x:Name="DanmakuSwitch"
                            Grid.Column="1"
                            OnContent=""
                            OffContent=""
                            Toggled="DanmakuSwitch_Toggled" />
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="200" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource RowTitleStyle}" Text="不透明度" />
                            <TextBlock x:Name="OpacityValueText" Style="{StaticResource RowDescStyle}" Text="90%" />
                        </StackPanel>
                        <Slider
                            x:Name="OpacitySlider"
                            Grid.Column="1"
                            Maximum="1"
                            Minimum="0.2"
                            StepFrequency="0.05"
                            ValueChanged="OpacitySlider_ValueChanged" />
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="200" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource RowTitleStyle}" Text="字号" />
                            <TextBlock x:Name="FontSizeValueText" Style="{StaticResource RowDescStyle}" Text="24" />
                        </StackPanel>
                        <Slider
                            x:Name="FontSizeSlider"
                            Grid.Column="1"
                            Maximum="36"
                            Minimum="14"
                            StepFrequency="1"
                            ValueChanged="FontSizeSlider_ValueChanged" />
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="200" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource RowTitleStyle}" Text="滚动速度" />
                            <TextBlock x:Name="SpeedValueText" Style="{StaticResource RowDescStyle}" Text="9 秒横穿" />
                        </StackPanel>
                        <Slider
                            x:Name="SpeedSlider"
                            Grid.Column="1"
                            Maximum="16"
                            Minimum="4"
                            StepFrequency="0.5"
                            ValueChanged="SpeedSlider_ValueChanged" />
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource RowTitleStyle}" Text="显示区域" />
                            <TextBlock Style="{StaticResource RowDescStyle}" Text="弹幕占用画面上方多少高度，避免盖住字幕" />
                        </StackPanel>
                        <ComboBox
                            x:Name="AreaBox"
                            Grid.Column="1"
                            MinWidth="132"
                            SelectionChanged="AreaBox_SelectionChanged">
                            <ComboBoxItem Content="1/4 画面" />
                            <ComboBoxItem Content="1/2 画面" />
                            <ComboBoxItem Content="3/4 画面" />
                            <ComboBoxItem Content="整屏" />
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 直播 -->
            <Border Style="{StaticResource SectionCardStyle}">
                <StackPanel Spacing="14">
                    <TextBlock Style="{StaticResource GroupTitleTextStyle}" Text="直播" />

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource RowTitleStyle}" Text="默认画质" />
                            <TextBlock Style="{StaticResource RowDescStyle}" Text="直播只有 FLV 一路，档位随主播推流规格变化（高清 / 超清 / 蓝光）" />
                        </StackPanel>
                        <ComboBox
                            x:Name="LiveQualityBox"
                            Grid.Column="1"
                            MinWidth="132"
                            SelectionChanged="LiveQualityBox_SelectionChanged">
                            <ComboBoxItem Content="自动（最高）" />
                            <ComboBoxItem Content="高清 1000" />
                            <ComboBoxItem Content="超清 2000" />
                            <ComboBoxItem Content="蓝光 4000" />
                            <ComboBoxItem Content="蓝光 8000" />
                        </ComboBox>
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource RowTitleStyle}" Text="D3D11 硬件解码" />
                            <TextBlock Style="{StaticResource RowDescStyle}" Text="FFmpegInteropX 硬解降低 CPU 占用；花屏 / 黑屏时关掉改用软解" />
                        </StackPanel>
                        <ToggleSwitch
                            x:Name="LiveHwSwitch"
                            Grid.Column="1"
                            OnContent=""
                            OffContent=""
                            Toggled="LiveHwSwitch_Toggled" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 数据与关于 -->
            <Border Style="{StaticResource SectionCardStyle}">
                <StackPanel Spacing="14">
                    <TextBlock Style="{StaticResource GroupTitleTextStyle}" Text="数据与关于" />

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="200" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource RowTitleStyle}" Text="列表每页条数" />
                            <TextBlock x:Name="PageSizeValueText" Style="{StaticResource RowDescStyle}" Text="20" />
                        </StackPanel>
                        <Slider
                            x:Name="PageSizeSlider"
                            Grid.Column="1"
                            Maximum="50"
                            Minimum="10"
                            StepFrequency="10"
                            ValueChanged="PageSizeSlider_ValueChanged" />
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource RowTitleStyle}" Text="配置文件位置" />
                            <TextBlock x:Name="SettingsPathText" Style="{StaticResource RowDescStyle}" Text="--" />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            Content="打开所在目录"
                            Click="OpenSettingsFolder_Click"
                            Style="{StaticResource AppButtonStyle}" />
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource RowTitleStyle}" Text="恢复默认设置" />
                            <TextBlock Style="{StaticResource RowDescStyle}" Text="把所有选项恢复为初始值（不会退出登录）" />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            Content="恢复默认"
                            Click="ResetButton_Click"
                            Style="{StaticResource AppButtonStyle}" />
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource RowTitleStyle}" Text="版本" />
                            <TextBlock x:Name="VersionText" Style="{StaticResource RowDescStyle}" Text="--" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{StaticResource TextFillColorSecondaryBrush}"
                            Text="AStation.Client · 第三方客户端" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
