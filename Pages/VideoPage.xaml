<Page
    x:Class="AStation_Client.Pages.VideoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AStation_Client.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="using:AStation_Client.Pages"
    xmlns:svc="using:AStation_Client.Services"
    mc:Ignorable="d"
    KeyboardAcceleratorPlacementMode="Hidden">

    <Page.KeyboardAccelerators>
        <!-- PlacementMode=Hidden 设在 Page 上：否则按住 Alt 时画面上会浮出一个 "Esc" 提示框 -->
        <KeyboardAccelerator Key="Escape" Invoked="EscapeAccelerator_Invoked" />
    </Page.KeyboardAccelerators>


    <Page.Resources>
        <!-- 播放器图标按钮：32×32 圆形、透明底、白色前景（对应 Bili.Copilot 的 BasicPlayerIconButtonStyle） -->
        <Style x:Key="PlayerIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- 播放器文字按钮（倍速 / 清晰度 / 线路）：胶囊底 + 12 号字 -->
        <Style x:Key="PlayerTextButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="#1FFFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- 播放/暂停主按钮：52 圆形白底黑字 -->
        <Style x:Key="PlayerPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="52" />
            <Setter Property="Height" Value="52" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="#E6FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="26" />
            <Setter Property="Foreground" Value="#FF000000" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- 播放器里的时间 / 小字 -->
        <Style x:Key="PlayerTimeTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#B3FFFFFF" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsTextScaleFactorEnabled" Value="False" />
        </Style>

        <!-- 播放器内的下拉面板：紧凑内边距 -->
        <Style x:Key="PlayerFlyoutPresenterStyle" TargetType="FlyoutPresenter">
            <!-- Flyout 本身没有 RequestedTheme，深色主题挂在 FlyoutPresenter 上 -->
            <Setter Property="RequestedTheme" Value="Dark" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MaxWidth" Value="480" />
        </Style>
    </Page.Resources>

    <Grid x:Name="PageRoot" Background="{StaticResource AppShellAcrylicBrush}">
        <ScrollViewer
            x:Name="RootScroll"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto">
            <Grid
                x:Name="LayoutGrid"
                Padding="20,4,20,24"
                ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="SideColumn" Width="340" />
                </Grid.ColumnDefinitions>

                <!-- ══════════════ 左：播放器 + 视频信息 ══════════════ -->
                <StackPanel Grid.Column="0" Spacing="12">

                    <!--
                        播放器：空间结构对齐 Bili.Copilot 的 PlayerOverlay
                        顶部标题条（60px 渐变） / 底部控制层（160px 渐变：左信息位 · 中播放组 · 右附加控制 · 下行进度）
                        控制层整体淡入淡出，收起后底部留一条细进度
                    -->
                    <Grid
                        x:Name="PlayerHost"
                        Background="Black"
                        CornerRadius="10"
                        SizeChanged="PlayerHost_SizeChanged">

                        <!-- 关掉系统传输控件，控制层自己画 -->
                        <MediaPlayerElement
                            x:Name="Player"
                            AreTransportControlsEnabled="False"
                            AutoPlay="True"
                            RequestedTheme="Dark"
                            Stretch="Uniform" />

                        <!-- 弹幕层（不挡交互） -->
                        <Grid x:Name="DanmakuLayer" IsHitTestVisible="False">
                            <controls:DanmakuPanel x:Name="DanmakuControl" />
                        </Grid>

                        <!-- 加载 / 状态 -->
                        <StackPanel
                            x:Name="StatusPanel"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="10">
                            <ProgressRing
                                x:Name="LoadingRing"
                                Width="28"
                                Height="28"
                                Foreground="White"
                                IsActive="True" />
                            <TextBlock
                                x:Name="StatusText"
                                MaxWidth="420"
                                Text="正在加载播放数据…"
                                Foreground="White"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- ══════════ 控制层：顶栏 + 控制条 + 提示气泡 ══════════ -->
                        <Grid x:Name="ControlsLayer" RequestedTheme="Dark">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="ControlsTransform" />
                            </Grid.RenderTransform>

                            <!-- ── 顶部标题条：全屏时显示 ── -->
                            <Grid
                                x:Name="TopBar"
                                Height="60"
                                VerticalAlignment="Top"
                                Visibility="Collapsed">
                                <Grid.Background>
                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                        <GradientStop Offset="0" Color="#FF000000" />
                                        <GradientStop Offset="1" Color="#00000000" />
                                    </LinearGradientBrush>
                                </Grid.Background>
                                <Grid Padding="12,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Button
                                        x:Name="ExitFullscreenButton"
                                        Height="32"
                                        Padding="12,0"
                                        VerticalAlignment="Center"
                                        Background="#33FFFFFF"
                                        BorderThickness="0"
                                        Click="FullscreenButton_Click"
                                        CornerRadius="16"
                                        Foreground="White"
                                        ToolTipService.ToolTip="退出全屏（Esc）">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontSize="12" Glyph="&#xE73F;" />
                                            <TextBlock FontSize="12" Text="退出全屏" />
                                        </StackPanel>
                                    </Button>

                                    <TextBlock
                                        x:Name="OverlayTitle"
                                        Grid.Column="1"
                                        MaxWidth="520"
                                        Margin="12,0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Foreground="#E6FFFFFF"
                                        TextTrimming="CharacterEllipsis" />

                                    <TextBlock
                                        x:Name="OverlayEpisodeText"
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="#99FFFFFF" />
                                </Grid>
                            </Grid>

                            <!-- ── 底部控制层 ── -->
                            <Grid
                                x:Name="ControlBar"
                                Height="160"
                                VerticalAlignment="Bottom"
                                PointerEntered="ControlBar_PointerEntered"
                                PointerExited="ControlBar_PointerExited">
                                <Grid.Background>
                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                        <GradientStop Offset="0" Color="#00000000" />
                                        <GradientStop Offset="0.5" Color="#B3000000" />
                                        <GradientStop Offset="1" Color="#FF000000" />
                                    </LinearGradientBrush>
                                </Grid.Background>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- 上行：左信息位 / 中播放控制 / 右附加控制 -->
                                <Grid Padding="16,0,10,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 左侧信息位：标题 + 作者 · 当前集 -->
                                    <StackPanel
                                        x:Name="PlayerInfoSlot"
                                        Margin="0,0,16,0"
                                        VerticalAlignment="Center"
                                        Spacing="3">
                                        <TextBlock
                                            x:Name="PlayerTitleText"
                                            MaxWidth="260"
                                            FontSize="14"
                                            Foreground="White"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            x:Name="PlayerSubText"
                                            MaxWidth="260"
                                            FontSize="12"
                                            Foreground="#99FFFFFF"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <!-- 中：上一集 / 后退 10s / 播放暂停 / 前进 10s / 下一集 -->
                                    <StackPanel
                                        Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                        <Button
                                            x:Name="PrevButton"
                                            AutomationProperties.Name="上一集"
                                            Margin="0,0,8,0"
                                            Click="PrevButton_Click"
                                            Style="{StaticResource PlayerIconButtonStyle}"
                                            ToolTipService.ToolTip="上一集 / 上一P">
                                            <Button.Resources>
                                                <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#4DFFFFFF" />
                                                <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                                            </Button.Resources>
                                            <FontIcon FontSize="14" Glyph="&#xE892;" />
                                        </Button>
                                        <Button
                                            x:Name="BackwardButton"
                                            AutomationProperties.Name="后退10秒"
                                            Margin="0,0,8,0"
                                            Click="SkipBackward_Click"
                                            Style="{StaticResource PlayerIconButtonStyle}"
                                            ToolTipService.ToolTip="后退 10 秒">
                                            <FontIcon FontSize="14" Glyph="&#xE100;" />
                                        </Button>
                                        <Button
                                            x:Name="PlayPauseButton"
                                            AutomationProperties.Name="播放暂停"
                                            Click="PlayPauseButton_Click"
                                            Style="{StaticResource PlayerPrimaryButtonStyle}"
                                            ToolTipService.ToolTip="播放 / 暂停">
                                            <FontIcon x:Name="PlayPauseIcon" FontSize="20" Glyph="&#xE768;" />
                                        </Button>
                                        <Button
                                            x:Name="ForwardButton"
                                            AutomationProperties.Name="前进10秒"
                                            Margin="8,0,0,0"
                                            Click="SkipForward_Click"
                                            Style="{StaticResource PlayerIconButtonStyle}"
                                            ToolTipService.ToolTip="前进 10 秒">
                                            <FontIcon FontSize="14" Glyph="&#xE102;" />
                                        </Button>
                                        <Button
                                            x:Name="NextButton"
                                            AutomationProperties.Name="下一集"
                                            Margin="8,0,0,0"
                                            Click="NextButton_Click"
                                            Style="{StaticResource PlayerIconButtonStyle}"
                                            ToolTipService.ToolTip="下一集 / 下一P">
                                            <Button.Resources>
                                                <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#4DFFFFFF" />
                                                <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                                            </Button.Resources>
                                            <FontIcon FontSize="14" Glyph="&#xE893;" />
                                        </Button>
                                    </StackPanel>

                                    <!-- 右：音量 / 倍速 / 弹幕 / 清晰度 / 线路 / 全屏 -->
                                    <StackPanel
                                        Grid.Column="2"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="6">

                                        <Button
                                            x:Name="MuteButton"
                                            AutomationProperties.Name="静音"
                                            Click="MuteButton_Click"
                                            Style="{StaticResource PlayerIconButtonStyle}"
                                            ToolTipService.ToolTip="静音 / 取消静音">
                                            <FontIcon x:Name="VolumeIcon" FontSize="14" Glyph="&#xE767;" />
                                        </Button>
                                        <Slider
                                            x:Name="VolumeSlider"
                                            AutomationProperties.Name="音量"
                                            Width="80"
                                            VerticalAlignment="Center"
                                            Maximum="1"
                                            Minimum="0"
                                            StepFrequency="0.01"
                                            ToolTipService.ToolTip="音量"
                                            Value="1"
                                            ValueChanged="VolumeSlider_ValueChanged" />

                                        <Button
                                            x:Name="SpeedButton"
                                            AutomationProperties.Name="倍速"
                                            Style="{StaticResource PlayerTextButtonStyle}"
                                            ToolTipService.ToolTip="倍速播放">
                                            <TextBlock x:Name="SpeedText" Text="1.0x" />
                                            <Button.Flyout>
                                                <Flyout
                                                    Placement="Top"
                                                    Closed="SpeedFlyout_Closed"
                                                    FlyoutPresenterStyle="{StaticResource PlayerFlyoutPresenterStyle}"
                                                    Opened="SpeedFlyout_Opened">
                                                    <StackPanel Spacing="10" Width="304">
                                                        <Grid x:Name="SpeedQuickPanel" Height="30" ColumnSpacing="4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition />
                                                                <ColumnDefinition />
                                                                <ColumnDefinition />
                                                                <ColumnDefinition />
                                                                <ColumnDefinition />
                                                                <ColumnDefinition />
                                                            </Grid.ColumnDefinitions>
                                                            <ToggleButton
                                                                HorizontalAlignment="Stretch"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Click="SpeedQuickButton_Click"
                                                                Content="0.5x"
                                                                Tag="0.5" />
                                                            <ToggleButton
                                                                Grid.Column="1"
                                                                HorizontalAlignment="Stretch"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Click="SpeedQuickButton_Click"
                                                                Content="0.75x"
                                                                Tag="0.75" />
                                                            <ToggleButton
                                                                Grid.Column="2"
                                                                HorizontalAlignment="Stretch"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Click="SpeedQuickButton_Click"
                                                                Content="1.0x"
                                                                Tag="1.0" />
                                                            <ToggleButton
                                                                Grid.Column="3"
                                                                HorizontalAlignment="Stretch"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Click="SpeedQuickButton_Click"
                                                                Content="1.25x"
                                                                Tag="1.25" />
                                                            <ToggleButton
                                                                Grid.Column="4"
                                                                HorizontalAlignment="Stretch"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Click="SpeedQuickButton_Click"
                                                                Content="1.5x"
                                                                Tag="1.5" />
                                                            <ToggleButton
                                                                Grid.Column="5"
                                                                HorizontalAlignment="Stretch"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Click="SpeedQuickButton_Click"
                                                                Content="2.0x"
                                                                Tag="2.0" />
                                                        </Grid>
                                                        <Slider
                                                            x:Name="SpeedSlider"
                                                            Margin="0,0,0,-6"
                                                            Maximum="2"
                                                            Minimum="0.5"
                                                            StepFrequency="0.05"
                                                            Value="1"
                                                            ValueChanged="SpeedSlider_ValueChanged" />
                                                    </StackPanel>
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>

                                        <ToggleButton
                                            x:Name="DanmakuToggle"
                                            Width="32"
                                            Height="32"
                                            Padding="0"
                                            AutomationProperties.Name="弹幕开关"
                                            Content="弹"
                                            CornerRadius="16"
                                            FontSize="12"
                                            FontWeight="Black"
                                            IsChecked="True"
                                            ToolTipService.ToolTip="开 / 关弹幕"
                                            Click="DanmakuToggle_Click" />

                                        <Button
                                            x:Name="QualityButton"
                                            AutomationProperties.Name="清晰度"
                                            Style="{StaticResource PlayerTextButtonStyle}"
                                            ToolTipService.ToolTip="清晰度">
                                            <TextBlock x:Name="QualityText" Text="清晰度" />
                                            <Button.Flyout>
                                                <Flyout
                                                    Placement="Top"
                                                    FlyoutPresenterStyle="{StaticResource PlayerFlyoutPresenterStyle}">
                                                    <ListView
                                                        x:Name="QualityBox"
                                                        MinWidth="200"
                                                        MaxHeight="320"
                                                        SelectionChanged="QualityBox_SelectionChanged"
                                                        SelectionMode="Single">
                                                        <ListView.ItemTemplate>
                                                            <DataTemplate x:DataType="svc:PlayQuality">
                                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                                    <TextBlock FontSize="13" Text="{x:Bind Label}" />
                                                                    <TextBlock
                                                                        FontSize="11"
                                                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                        Text="{x:Bind ResolutionText}" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ListView.ItemTemplate>
                                                    </ListView>
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>

                                        <Button
                                            x:Name="CdnButton"
                                            AutomationProperties.Name="线路"
                                            Style="{StaticResource PlayerTextButtonStyle}"
                                            ToolTipService.ToolTip="切换线路，播放卡顿时可换源">
                                            <TextBlock x:Name="CdnText" Text="线路" />
                                            <Button.Flyout>
                                                <Flyout
                                                    Placement="Top"
                                                    FlyoutPresenterStyle="{StaticResource PlayerFlyoutPresenterStyle}">
                                                    <ListView
                                                        x:Name="CdnBox"
                                                        MinWidth="200"
                                                        MaxHeight="320"
                                                        SelectionChanged="CdnBox_SelectionChanged"
                                                        SelectionMode="Single">
                                                        <ListView.ItemTemplate>
                                                            <DataTemplate x:DataType="svc:CdnSource">
                                                                <StackPanel Spacing="2">
                                                                    <TextBlock FontSize="13" Text="{x:Bind Name}" />
                                                                    <TextBlock
                                                                        FontSize="11"
                                                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                        Text="{x:Bind Host}" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ListView.ItemTemplate>
                                                    </ListView>
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>

                                        <Button
                                            x:Name="FullscreenButton"
                                            AutomationProperties.Name="全屏"
                                            Click="FullscreenButton_Click"
                                            Style="{StaticResource PlayerIconButtonStyle}"
                                            ToolTipService.ToolTip="全屏（Esc 退出）">
                                            <FontIcon x:Name="FullscreenIcon" FontSize="14" Glyph="&#xE740;" />
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- 下行：当前时间 + 进度条 + 总时长 -->
                                <Grid
                                    Grid.Row="1"
                                    Margin="16,0,16,12"
                                    ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="56" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        x:Name="PositionText"
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource PlayerTimeTextStyle}"
                                        Text="00:00" />
                                    <Slider
                                        x:Name="ProgressSlider"
                                        AutomationProperties.Name="播放进度"
                                        Grid.Column="1"
                                        Height="24"
                                        MinWidth="0"
                                        VerticalAlignment="Center"
                                        IsThumbToolTipEnabled="False"
                                        Maximum="1"
                                        Minimum="0"
                                        PointerCaptureLost="ProgressSlider_PointerCaptureLost"
                                        PointerPressed="ProgressSlider_PointerPressed"
                                        PointerReleased="ProgressSlider_PointerReleased"
                                        ToolTipService.ToolTip="拖动调整播放进度"
                                        ValueChanged="ProgressSlider_ValueChanged" />
                                    <TextBlock
                                        x:Name="DurationText"
                                        Grid.Column="2"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource PlayerTimeTextStyle}"
                                        Text="00:00" />
                                </Grid>
                            </Grid>

                        </Grid>

                        <!-- 提示气泡独立一层：控制层收起时也要能看见 -->
                                <!-- 中部提示气泡：拖动进度 / 调整倍速 -->
                                <Border
                                    x:Name="SeekBubble"
                                    Margin="0,76,0,0"
                                    Padding="18,8"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    Background="#CC1F1F1F"
                                    CornerRadius="16"
                                    Visibility="Collapsed">
                                    <TextBlock
                                        x:Name="SeekBubbleText"
                                        FontSize="14"
                                        Foreground="White"
                                        IsTextScaleFactorEnabled="False"
                                        Text="00:00 / 00:00" />
                                </Border>
                                <Border
                                    x:Name="SpeedBubble"
                                    Margin="0,76,0,0"
                                    Padding="18,8"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    Background="#CC1F1F1F"
                                    CornerRadius="16"
                                    Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock
                                            FontSize="13"
                                            Foreground="#B3FFFFFF"
                                            Text="倍速播放" />
                                        <TextBlock
                                            x:Name="SpeedBubbleText"
                                            FontSize="14"
                                            Foreground="#FF8A00"
                                            Text="1.0x" />
                                    </StackPanel>
                                </Border>

                        <!-- 控制层收起时，底部留一条细进度 -->
                        <ProgressBar
                            x:Name="MiniProgress"
                            Height="4"
                            VerticalAlignment="Bottom"
                            Background="Transparent"
                            Foreground="#E6FFFFFF"
                            Maximum="1"
                            Minimum="0"
                            Visibility="Collapsed" />
                    </Grid>

                    <!-- 标题 / 作者 / 简介（全屏时整块隐藏） -->
                    <StackPanel x:Name="InfoPanel" Spacing="12">
                        <TextBlock
                            x:Name="TitleText"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="正在加载…"
                            TextWrapping="Wrap" />

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <PersonPicture
                                x:Name="AuthorAvatar"
                                Width="40"
                                Height="40"
                                VerticalAlignment="Center" />

                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="2">
                                <TextBlock x:Name="AuthorText" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock
                                    x:Name="MetaText"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{StaticResource TextFillColorSecondaryBrush}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <StackPanel
                                Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Spacing="8">
                                <Border
                                    Background="{StaticResource ControlFillColorSecondaryBrush}"
                                    CornerRadius="16"
                                    Padding="12,6">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontSize="12" Glyph="&#xE8E1;" />
                                        <TextBlock x:Name="LikeText" FontSize="12" Text="点赞" />
                                    </StackPanel>
                                </Border>
                                <Border
                                    Background="{StaticResource ControlFillColorSecondaryBrush}"
                                    CornerRadius="16"
                                    Padding="12,6">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontSize="12" Glyph="&#xE734;" />
                                        <TextBlock x:Name="FavoriteText" FontSize="12" Text="收藏" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Border
                            Background="{StaticResource ControlFillColorSecondaryBrush}"
                            CornerRadius="8"
                            Padding="14">
                            <Expander HorizontalAlignment="Stretch" IsExpanded="False">
                                <Expander.Header>
                                    <TextBlock Text="视频简介" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                </Expander.Header>
                                <TextBlock
                                    x:Name="DescriptionText"
                                    Margin="0,6,0,0"
                                    Foreground="{StaticResource TextFillColorSecondaryBrush}"
                                    IsTextSelectionEnabled="True"
                                    Text="暂无简介"
                                    TextWrapping="Wrap" />
                            </Expander>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- ══════════════ 右：分P / 评论 / 相关视频 ══════════════ -->
                <Border
                    x:Name="SidePanel"
                    Grid.Column="1"
                    Background="{StaticResource ControlFillColorSecondaryBrush}"
                    CornerRadius="8"
                    Padding="12"
                    VerticalAlignment="Top">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 标题 + 计数 -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Name="ListTitle"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="播放列表" />
                            <TextBlock
                                x:Name="ListCountText"
                                Grid.Column="1"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{StaticResource TextFillColorSecondaryBrush}" />
                        </Grid>

                        <!-- 分页切换 -->
                        <Grid
                            Grid.Row="1"
                            ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <ToggleButton
                                x:Name="PlaylistTab"
                                Grid.Column="0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Padding="0,6"
                                CornerRadius="6"
                                FontSize="12"
                                IsChecked="True"
                                Click="SideTab_Click"
                                Content="分P" />
                            <ToggleButton
                                x:Name="CommentTab"
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Padding="0,6"
                                CornerRadius="6"
                                FontSize="12"
                                Click="SideTab_Click"
                                Content="评论" />
                            <ToggleButton
                                x:Name="RelatedTab"
                                Grid.Column="2"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Padding="0,6"
                                CornerRadius="6"
                                FontSize="12"
                                Click="SideTab_Click"
                                Content="相关" />
                        </Grid>

                        <!-- 内容区：三个列表叠放，按 tab 显示其一 -->
                        <Grid Grid.Row="2" MinHeight="360">

                            <!-- 分P / 选集 -->
                            <ListView
                                x:Name="EpisodeList"
                                MaxHeight="560"
                                IsItemClickEnabled="True"
                                ItemClick="EpisodeList_ItemClick"
                                SelectionMode="Single">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="pages:PlaylistEntry">
                                        <Grid ColumnSpacing="10" Padding="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border
                                                MinWidth="26"
                                                Height="26"
                                                Background="{StaticResource ControlFillColorDefaultBrush}"
                                                CornerRadius="13">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="11"
                                                    Text="{x:Bind IndexText}" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock
                                                    FontSize="13"
                                                    MaxLines="1"
                                                    Text="{x:Bind Title}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="{StaticResource TextFillColorSecondaryBrush}"
                                                    MaxLines="1"
                                                    Text="{x:Bind SubText}"
                                                    TextTrimming="CharacterEllipsis"
                                                    Visibility="{x:Bind SubText, Converter={StaticResource ObjectToVisibilityConverter}}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <!-- 评论 -->
                            <ListView
                                x:Name="CommentList"
                                MaxHeight="560"
                                SelectionMode="None"
                                Visibility="Collapsed">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0,6" />
                                        <Setter Property="MinHeight" Value="0" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="svc:CommentItem">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <PersonPicture
                                                Width="28"
                                                Height="28"
                                                VerticalAlignment="Top"
                                                DisplayName="{x:Bind UserName}"
                                                ProfilePicture="{x:Bind Avatar, Converter={StaticResource StringToImageSourceConverter}}" />

                                            <StackPanel Grid.Column="1" Spacing="3">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="{StaticResource TextFillColorSecondaryBrush}"
                                                        MaxLines="1"
                                                        Text="{x:Bind UserName}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <Border
                                                        Padding="4,0"
                                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                        CornerRadius="3"
                                                        Visibility="{x:Bind IsUp, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <TextBlock
                                                            FontSize="9"
                                                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                            Text="UP" />
                                                    </Border>
                                                    <Border
                                                        Padding="4,0"
                                                        Background="{StaticResource ControlFillColorDefaultBrush}"
                                                        CornerRadius="3"
                                                        Visibility="{x:Bind IsSticky, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <TextBlock FontSize="9" Text="置顶" />
                                                    </Border>
                                                </StackPanel>

                                                <TextBlock
                                                    FontSize="13"
                                                    IsTextSelectionEnabled="True"
                                                    MaxLines="8"
                                                    Text="{x:Bind Content}"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="Wrap" />

                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="{StaticResource TextFillColorSecondaryBrush}"
                                                        Text="{x:Bind PostDate}" />
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="{StaticResource TextFillColorSecondaryBrush}"
                                                        Text="{x:Bind LikeCountText}" />
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="{StaticResource TextFillColorSecondaryBrush}"
                                                        Text="{x:Bind SubCommentText}"
                                                        Visibility="{x:Bind ShowPlainSubText, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                </StackPanel>

                                                <!-- 展开 / 收起楼中楼 -->
                                                <Button
                                                    Margin="0,1,0,0"
                                                    Padding="8,2"
                                                    HorizontalAlignment="Left"
                                                    Background="{StaticResource ControlFillColorDefaultBrush}"
                                                    BorderThickness="0"
                                                    CornerRadius="4"
                                                    Visibility="{x:Bind CanExpand, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Click="ReplyToggle_Click">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <TextBlock
                                                            FontSize="11"
                                                            Text="{x:Bind ReplyToggleText, Mode=OneWay}" />
                                                        <FontIcon
                                                            FontSize="8"
                                                            Glyph="{x:Bind ReplyToggleGlyph, Mode=OneWay}" />
                                                    </StackPanel>
                                                </Button>

                                                <!-- 楼中楼内容 -->
                                                <StackPanel
                                                    Margin="0,4,0,0"
                                                    Spacing="6"
                                                    Visibility="{x:Bind IsExpanded, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <ItemsControl ItemsSource="{x:Bind Replies}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="svc:CommentItem">
                                                                <Grid
                                                                    Margin="0,0,0,8"
                                                                    ColumnSpacing="7"
                                                                    BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                                                                    BorderThickness="2,0,0,0"
                                                                    Padding="10,0,0,0">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>

                                                                    <PersonPicture
                                                                        Width="20"
                                                                        Height="20"
                                                                        VerticalAlignment="Top"
                                                                        DisplayName="{x:Bind UserName}"
                                                                        ProfilePicture="{x:Bind Avatar, Converter={StaticResource StringToImageSourceConverter}}" />

                                                                    <StackPanel Grid.Column="1" Spacing="2">
                                                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                                                            <TextBlock
                                                                                FontSize="11"
                                                                                Foreground="{StaticResource TextFillColorSecondaryBrush}"
                                                                                MaxLines="1"
                                                                                Text="{x:Bind UserName}"
                                                                                TextTrimming="CharacterEllipsis" />
                                                                            <Border
                                                                                Padding="4,0"
                                                                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                                                CornerRadius="3"
                                                                                Visibility="{x:Bind IsUp, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                                <TextBlock
                                                                                    FontSize="9"
                                                                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                                                    Text="UP" />
                                                                            </Border>
                                                                        </StackPanel>

                                                                        <TextBlock
                                                                            FontSize="12"
                                                                            IsTextSelectionEnabled="True"
                                                                            MaxLines="6"
                                                                            Text="{x:Bind Content}"
                                                                            TextTrimming="CharacterEllipsis"
                                                                            TextWrapping="Wrap" />

                                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                                            <TextBlock
                                                                                FontSize="10"
                                                                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                                                Text="{x:Bind ReplyToText}"
                                                                                Visibility="{x:Bind HasReplyTo, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                            <TextBlock
                                                                                FontSize="10"
                                                                                Foreground="{StaticResource TextFillColorSecondaryBrush}"
                                                                                Text="{x:Bind PostDate}" />
                                                                            <TextBlock
                                                                                FontSize="10"
                                                                                Foreground="{StaticResource TextFillColorSecondaryBrush}"
                                                                                Text="{x:Bind LikeCountText}" />
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <!-- 接口每个主楼只下发前 3 条，差额提示一下 -->
                                                    <TextBlock
                                                        FontSize="10"
                                                        Foreground="{StaticResource TextFillColorTertiaryBrush}"
                                                        Text="{x:Bind HiddenReplyText}"
                                                        Visibility="{x:Bind HasHiddenReplies, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <!-- 相关视频 -->
                            <ListView
                                x:Name="RelatedList"
                                MaxHeight="560"
                                IsItemClickEnabled="True"
                                ItemClick="RelatedList_ItemClick"
                                SelectionMode="Single"
                                Visibility="Collapsed">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0,5" />
                                        <Setter Property="MinHeight" Value="0" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="svc:RelatedVideoItem">
                                        <Grid ColumnSpacing="9">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="104" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Grid
                                                Height="59"
                                                Background="{StaticResource ControlFillColorDefaultBrush}"
                                                CornerRadius="5">
                                                <Image
                                                    Source="{x:Bind Cover, Converter={StaticResource StringToImageSourceConverter}}"
                                                    Stretch="UniformToFill" />
                                            </Grid>

                                            <StackPanel
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Spacing="3">
                                                <TextBlock
                                                    FontSize="12"
                                                    MaxLines="2"
                                                    Text="{x:Bind Title}"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="Wrap" />
                                                <TextBlock
                                                    FontSize="10"
                                                    Foreground="{StaticResource TextFillColorSecondaryBrush}"
                                                    MaxLines="1"
                                                    Text="{x:Bind SubText}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <!-- 空状态 / 提示 -->
                            <TextBlock
                                x:Name="SideEmptyHint"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Margin="0,24,0,0"
                                Foreground="{StaticResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                TextAlignment="Center"
                                TextWrapping="Wrap"
                                Visibility="Collapsed" />
                        </Grid>

                        <!-- 评论加载更多 -->
                        <Button
                            x:Name="LoadMoreCommentButton"
                            Grid.Row="3"
                            HorizontalAlignment="Center"
                            Padding="14,5"
                            FontSize="12"
                            Visibility="Collapsed"
                            Click="LoadMoreCommentButton_Click"
                            Content="加载更多评论" />
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
