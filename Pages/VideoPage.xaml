<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AStation_Client.Pages.VideoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AStation_Client.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="using:AStation_Client.Pages"
    xmlns:svc="using:AStation_Client.Services"
    mc:Ignorable="d"
    KeyboardAcceleratorPlacementMode="Hidden">

    <Page.KeyboardAccelerators>
        <!-- PlacementMode=Hidden 设在 Page 上：否则按住 Alt 时画面上会浮出一个 "Esc" 提示框 -->
        <KeyboardAccelerator Key="Escape" Invoked="EscapeAccelerator_Invoked" />
    </Page.KeyboardAccelerators>

    <!-- 清晰度 / 线路两个 Flyout 的条目模板：列表实例在代码里创建后挂到播放器控件 -->
    <Page.Resources>
        <DataTemplate x:Key="PlayQualityTemplate" x:DataType="svc:PlayQuality">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock FontSize="13" Text="{x:Bind Label}" />
                <TextBlock
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="{x:Bind ResolutionText}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="CdnSourceTemplate" x:DataType="svc:CdnSource">
            <StackPanel Spacing="2">
                <TextBlock FontSize="13" Text="{x:Bind Name}" />
                <TextBlock
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="{x:Bind Host}" />
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <!--
        播放页骨架（点播 / 直播共用同一套空间逻辑）
          左列（*）：Row0 播放器（16:9）+ Row1「信息 + 评论」
          右列（340~380）：选集 / 相关，贯通两行、与播放器等高的整条侧栏
          页面本身不滚动，评论与列表各自滚动；窄屏把侧栏折到最下方；
          全屏时右列宽度与内容行一起归零，播放器独占整个窗口
    -->
    <Grid x:Name="PageRoot" Background="Transparent">

        <!-- 全屏兜底底色：用主题资源，切浅色 / 深色时自动跟随 -->
        <Border
            x:Name="FullscreenBackdrop"
            Background="{ThemeResource PlayerBackdropBrush}"
            Visibility="Collapsed" />

        <Grid
            x:Name="LayoutGrid"
            Padding="{StaticResource PagePadding}"
            ColumnSpacing="18"
            RowSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="320" />
                <ColumnDefinition x:Name="SideColumn" Width="340" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="PlayerRow" Height="Auto" />
                <RowDefinition x:Name="ContentRow" Height="*" />
            </Grid.RowDefinitions>

            <!-- 统一播放器层（与直播页共用）：视频 / 弹幕 / 状态 / 顶栏 / 控制栏 / 气泡 / 全屏 -->
            <controls:PlayerOverlay
                x:Name="Overlay"
                Grid.Row="0"
                Grid.Column="0" />

            <!--
                宽屏：BodyScroll 关掉滚动，内容区高度=视口，评论自己滚动（列表虚拟化）
                窄屏：打开滚动，整体按内容高度堆叠，列表给固定高度
            -->
            <ScrollViewer
                x:Name="BodyScroll"
                Grid.Row="1"
                Grid.Column="0"
                HorizontalContentAlignment="Stretch"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                VerticalContentAlignment="Stretch"
                VerticalScrollBarVisibility="Hidden"
                VerticalScrollMode="Disabled">

            <Grid x:Name="BodyGrid" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition x:Name="StackedRow" Height="0" />
                </Grid.RowDefinitions>

                <!-- ═══════════ 左列：视频信息（固定）+ 评论（滚动） ═══════════ -->
                <Grid
                    x:Name="MainColumn"
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel
                        x:Name="InfoPanel"
                        Grid.Row="0"
                        Spacing="10">
                        <TextBlock
                            x:Name="TitleText"
                            FontSize="18"
                            FontWeight="SemiBold"
                            MaxLines="2"
                            Text="正在加载…"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap" />

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" MinWidth="120" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <PersonPicture
                                x:Name="AuthorAvatar"
                                Width="38"
                                Height="38"
                                VerticalAlignment="Center" />

                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="2">
                                <TextBlock
                                    x:Name="AuthorText"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    x:Name="MetaText"
                                    Style="{StaticResource MetaTextStyle}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <!-- 点赞 / 收藏：真正的按钮（未登录时置灰并给出说明），不再是假按钮 -->
                            <StackPanel
                                x:Name="ActionPanel"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="6">
                                <Button
                                    x:Name="LikeButton"
                                    AutomationProperties.Name="点赞"
                                    Click="LikeButton_Click"
                                    Style="{StaticResource ChipButtonStyle}"
                                    ToolTipService.ToolTip="点赞">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontSize="12" Glyph="&#xE8E1;" />
                                        <TextBlock x:Name="LikeText" FontSize="12" Text="点赞" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    x:Name="FavoriteButton"
                                    AutomationProperties.Name="收藏"
                                    Click="FavoriteButton_Click"
                                    Style="{StaticResource ChipButtonStyle}"
                                    ToolTipService.ToolTip="收藏">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontSize="12" Glyph="&#xE734;" />
                                        <TextBlock x:Name="FavoriteText" FontSize="12" Text="收藏" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- 简介：2 行截断 + 展开（高度变化只在左列内部，不推整页） -->
                        <StackPanel Spacing="2">
                            <TextBlock
                                x:Name="DescriptionText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                IsTextSelectionEnabled="True"
                                MaxLines="2"
                                Text="暂无简介"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap" />
                            <Button
                                x:Name="DescriptionToggle"
                                Padding="0,2"
                                HorizontalAlignment="Left"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="DescriptionToggle_Click"
                                Content="展开简介"
                                FontSize="12"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Visibility="Collapsed" />
                        </StackPanel>
                    </StackPanel>

                    <!-- 评论：移到播放器下方通栏，长评论可读性远好于 340 侧栏 -->
                    <Grid
                        x:Name="CommentSection"
                        Grid.Row="1"
                        RowSpacing="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                FontSize="15"
                                FontWeight="SemiBold"
                                Text="评论" />
                            <TextBlock
                                x:Name="CommentCountText"
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource MetaTextStyle}" />
                            <ProgressRing
                                x:Name="CommentLoadingRing"
                                Grid.Column="2"
                                Width="16"
                                Height="16"
                                IsActive="False"
                                Visibility="Collapsed" />
                        </Grid>

                        <Grid Grid.Row="1">
                            <ListView
                                x:Name="CommentList"
                                SelectionMode="None">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0,8" />
                                        <Setter Property="MinHeight" Value="0" />
                                        <Setter Property="CornerRadius" Value="6" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="svc:CommentItem">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <PersonPicture
                                                Width="32"
                                                Height="32"
                                                VerticalAlignment="Top"
                                                DisplayName="{x:Bind UserName}"
                                                ProfilePicture="{x:Bind Avatar, Converter={StaticResource StringToImageSourceConverter}}" />

                                            <StackPanel Grid.Column="1" Spacing="3">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        MaxLines="1"
                                                        Text="{x:Bind UserName}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <Border
                                                        Padding="4,0"
                                                        VerticalAlignment="Center"
                                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                        CornerRadius="3"
                                                        Visibility="{x:Bind IsUp, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <TextBlock
                                                            FontSize="9"
                                                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                            Text="UP" />
                                                    </Border>
                                                    <Border
                                                        Padding="4,0"
                                                        VerticalAlignment="Center"
                                                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                        CornerRadius="3"
                                                        Visibility="{x:Bind IsSticky, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <TextBlock FontSize="9" Text="置顶" />
                                                    </Border>
                                                </StackPanel>

                                                <TextBlock
                                                    FontSize="13"
                                                    IsTextSelectionEnabled="True"
                                                    MaxLines="12"
                                                    Text="{x:Bind Content}"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="Wrap" />

                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{x:Bind PostDate}" />
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{x:Bind LikeCountText}" />
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{x:Bind SubCommentText}"
                                                        Visibility="{x:Bind ShowPlainSubText, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                </StackPanel>

                                                <!-- 展开 / 收起楼中楼 -->
                                                <Button
                                                    Margin="0,1,0,0"
                                                    Padding="8,2"
                                                    HorizontalAlignment="Left"
                                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                    BorderThickness="0"
                                                    CornerRadius="4"
                                                    Visibility="{x:Bind CanExpand, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Click="ReplyToggle_Click">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <TextBlock
                                                            FontSize="11"
                                                            Text="{x:Bind ReplyToggleText, Mode=OneWay}" />
                                                        <FontIcon
                                                            FontSize="8"
                                                            Glyph="{x:Bind ReplyToggleGlyph, Mode=OneWay}" />
                                                    </StackPanel>
                                                </Button>

                                                <!-- 楼中楼内容 -->
                                                <StackPanel
                                                    Margin="0,4,0,0"
                                                    Spacing="6"
                                                    Visibility="{x:Bind IsExpanded, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <ItemsControl ItemsSource="{x:Bind Replies}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="svc:CommentItem">
                                                                <Grid
                                                                    Margin="0,0,0,8"
                                                                    Padding="10,0,0,0"
                                                                    BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                                                                    BorderThickness="2,0,0,0"
                                                                    ColumnSpacing="7">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>

                                                                    <PersonPicture
                                                                        Width="22"
                                                                        Height="22"
                                                                        VerticalAlignment="Top"
                                                                        DisplayName="{x:Bind UserName}"
                                                                        ProfilePicture="{x:Bind Avatar, Converter={StaticResource StringToImageSourceConverter}}" />

                                                                    <StackPanel Grid.Column="1" Spacing="2">
                                                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                                                            <TextBlock
                                                                                FontSize="11"
                                                                                FontWeight="SemiBold"
                                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                                MaxLines="1"
                                                                                Text="{x:Bind UserName}"
                                                                                TextTrimming="CharacterEllipsis" />
                                                                            <Border
                                                                                Padding="4,0"
                                                                                VerticalAlignment="Center"
                                                                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                                                CornerRadius="3"
                                                                                Visibility="{x:Bind IsUp, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                                <TextBlock
                                                                                    FontSize="9"
                                                                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                                                    Text="UP" />
                                                                            </Border>
                                                                        </StackPanel>

                                                                        <TextBlock
                                                                            FontSize="12"
                                                                            IsTextSelectionEnabled="True"
                                                                            MaxLines="8"
                                                                            Text="{x:Bind Content}"
                                                                            TextTrimming="CharacterEllipsis"
                                                                            TextWrapping="Wrap" />

                                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                                            <TextBlock
                                                                                FontSize="10"
                                                                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                                                Text="{x:Bind ReplyToText}"
                                                                                Visibility="{x:Bind HasReplyTo, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                            <TextBlock
                                                                                FontSize="10"
                                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                                Text="{x:Bind PostDate}" />
                                                                            <TextBlock
                                                                                FontSize="10"
                                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                                Text="{x:Bind LikeCountText}" />
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <!-- 接口每个主楼只下发前 3 条，差额提示一下 -->
                                                    <TextBlock
                                                        FontSize="10"
                                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                        Text="{x:Bind HiddenReplyText}"
                                                        Visibility="{x:Bind HasHiddenReplies, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <!-- 统一三态：加载 / 空 / 失败 -->
                            <controls:StatePanel
                                x:Name="CommentState"
                                ActionClick="CommentState_ActionClick" />
                        </Grid>

                        <Button
                            x:Name="LoadMoreCommentButton"
                            Grid.Row="2"
                            Padding="16,5"
                            HorizontalAlignment="Center"
                            Click="LoadMoreCommentButton_Click"
                            Content="加载更多评论"
                            FontSize="12"
                            Visibility="Collapsed" />
                    </Grid>
                </Grid>

            </Grid>
            </ScrollViewer>
            <!-- ═══════════ 右列：选集 / 相关（窄窗口折到下方） ═══════════ -->
            <Border
                x:Name="SidePanel"
                Grid.Row="0"
                Grid.RowSpan="2"
                Grid.Column="1"
                Padding="12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusCard}">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ToggleButton
                            x:Name="PlaylistTab"
                            AutomationProperties.Name="选集"
                            Click="SideTab_Click"
                            Content="选集"
                            IsChecked="True"
                            Style="{StaticResource SegmentTabButtonStyle}" />
                        <ToggleButton
                            x:Name="RelatedTab"
                            Grid.Column="1"
                            AutomationProperties.Name="相关"
                            Click="SideTab_Click"
                            Content="相关"
                            Style="{StaticResource SegmentTabButtonStyle}" />
                        <TextBlock
                            x:Name="ListCountText"
                            Grid.Column="3"
                            VerticalAlignment="Center"
                            Style="{StaticResource MetaTextStyle}" />
                    </Grid>

                    <Grid Grid.Row="1">
                        <!-- 分P / 选集 -->
                        <ListView
                            x:Name="EpisodeList"
                            IsItemClickEnabled="True"
                            ItemClick="EpisodeList_ItemClick"
                            SelectionMode="Single"
                            ItemContainerStyle="{StaticResource ListViewItemFlushStyle}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="pages:PlaylistEntry">
                                    <Grid
                                        Padding="0,4"
                                        ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            MinWidth="26"
                                            Height="26"
                                            VerticalAlignment="Top"
                                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                                            CornerRadius="13">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="11"
                                                Text="{x:Bind IndexText}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock
                                                FontSize="13"
                                                MaxLines="2"
                                                Text="{x:Bind Title}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                MaxLines="1"
                                                Text="{x:Bind SubText}"
                                                TextTrimming="CharacterEllipsis"
                                                Visibility="{x:Bind SubText, Converter={StaticResource ObjectToVisibilityConverter}}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- 相关视频 -->
                        <ListView
                            x:Name="RelatedList"
                            IsItemClickEnabled="True"
                            ItemClick="RelatedList_ItemClick"
                            SelectionMode="Single"
                            Visibility="Collapsed"
                            ItemContainerStyle="{StaticResource ListViewItemFlushStyle}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="svc:RelatedVideoItem">
                                    <Grid
                                        Padding="0,5"
                                        ColumnSpacing="9">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="104" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Grid
                                            Height="59"
                                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                                            CornerRadius="5">
                                            <Image
                                                Source="{x:Bind Cover, Converter={StaticResource StringToImageSourceConverter}}"
                                                Stretch="UniformToFill" />
                                        </Grid>

                                        <StackPanel
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Spacing="3">
                                            <TextBlock
                                                FontSize="12"
                                                MaxLines="2"
                                                Text="{x:Bind Title}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                FontSize="10"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                MaxLines="1"
                                                Text="{x:Bind SubText}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <controls:StatePanel x:Name="SideState" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
