<Page
    x:Class="AStation_Client.Pages.VideoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AStation_Client.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="using:AStation_Client.Pages"
    xmlns:svc="using:AStation_Client.Services"
    mc:Ignorable="d"
    KeyboardAcceleratorPlacementMode="Hidden">

    <Page.KeyboardAccelerators>
        <!-- PlacementMode=Hidden 设在 Page 上：否则按住 Alt 时画面上会浮出一个 "Esc" 提示框 -->
        <KeyboardAccelerator Key="Escape" Invoked="EscapeAccelerator_Invoked" />
    </Page.KeyboardAccelerators>

    <!-- 清晰度 / 线路两个 Flyout 的条目模板：列表实例在代码里创建后挂到播放器控件 -->
    <Page.Resources>
        <DataTemplate x:Key="PlayQualityTemplate" x:DataType="svc:PlayQuality">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock FontSize="13" Text="{x:Bind Label}" />
                <TextBlock
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="{x:Bind ResolutionText}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="CdnSourceTemplate" x:DataType="svc:CdnSource">
            <StackPanel Spacing="2">
                <TextBlock FontSize="13" Text="{x:Bind Name}" />
                <TextBlock
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="{x:Bind Host}" />
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <Grid x:Name="PageRoot" Background="{StaticResource AppShellAcrylicBrush}">
        <ScrollViewer
            x:Name="RootScroll"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto">
            <Grid
                x:Name="LayoutGrid"
                Padding="20,4,20,24"
                ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="SideColumn" Width="340" />
                </Grid.ColumnDefinitions>

                <!-- ══════════════ 左：播放器 + 视频信息 ══════════════ -->
                <StackPanel Grid.Column="0" Spacing="12">

                    <!-- 统一播放器层（与直播页共用）：视频 / 弹幕 / 状态 / 顶栏 / 控制栏 / 气泡 / 全屏 -->
                    <controls:PlayerOverlay x:Name="Overlay" />

                    <!-- 标题 / 作者 / 简介（全屏时整块隐藏） -->
                    <StackPanel x:Name="InfoPanel" Spacing="12">
                        <TextBlock
                            x:Name="TitleText"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="正在加载…"
                            TextWrapping="Wrap" />

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <PersonPicture
                                x:Name="AuthorAvatar"
                                Width="40"
                                Height="40"
                                VerticalAlignment="Center" />

                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="2">
                                <TextBlock x:Name="AuthorText" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock
                                    x:Name="MetaText"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{StaticResource TextFillColorSecondaryBrush}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <StackPanel
                                Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Spacing="8">
                                <Border
                                    Background="{StaticResource ControlFillColorSecondaryBrush}"
                                    CornerRadius="16"
                                    Padding="12,6">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontSize="12" Glyph="&#xE8E1;" />
                                        <TextBlock x:Name="LikeText" FontSize="12" Text="点赞" />
                                    </StackPanel>
                                </Border>
                                <Border
                                    Background="{StaticResource ControlFillColorSecondaryBrush}"
                                    CornerRadius="16"
                                    Padding="12,6">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontSize="12" Glyph="&#xE734;" />
                                        <TextBlock x:Name="FavoriteText" FontSize="12" Text="收藏" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Border
                            Background="{StaticResource ControlFillColorSecondaryBrush}"
                            CornerRadius="8"
                            Padding="14">
                            <Expander HorizontalAlignment="Stretch" IsExpanded="False">
                                <Expander.Header>
                                    <TextBlock Text="视频简介" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                </Expander.Header>
                                <TextBlock
                                    x:Name="DescriptionText"
                                    Margin="0,6,0,0"
                                    Foreground="{StaticResource TextFillColorSecondaryBrush}"
                                    IsTextSelectionEnabled="True"
                                    Text="暂无简介"
                                    TextWrapping="Wrap" />
                            </Expander>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- ══════════════ 右：分P / 评论 / 相关视频 ══════════════ -->
                <Border
                    x:Name="SidePanel"
                    Grid.Column="1"
                    Background="{StaticResource ControlFillColorSecondaryBrush}"
                    CornerRadius="8"
                    Padding="12"
                    VerticalAlignment="Top">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 标题 + 计数 -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Name="ListTitle"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="播放列表" />
                            <TextBlock
                                x:Name="ListCountText"
                                Grid.Column="1"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{StaticResource TextFillColorSecondaryBrush}" />
                        </Grid>

                        <!-- 分页切换 -->
                        <Grid
                            Grid.Row="1"
                            ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <ToggleButton
                                x:Name="PlaylistTab"
                                Grid.Column="0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Padding="0,6"
                                CornerRadius="6"
                                FontSize="12"
                                IsChecked="True"
                                Click="SideTab_Click"
                                Content="分P" />
                            <ToggleButton
                                x:Name="CommentTab"
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Padding="0,6"
                                CornerRadius="6"
                                FontSize="12"
                                Click="SideTab_Click"
                                Content="评论" />
                            <ToggleButton
                                x:Name="RelatedTab"
                                Grid.Column="2"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Padding="0,6"
                                CornerRadius="6"
                                FontSize="12"
                                Click="SideTab_Click"
                                Content="相关" />
                        </Grid>

                        <!-- 内容区：三个列表叠放，按 tab 显示其一 -->
                        <Grid Grid.Row="2" MinHeight="360">

                            <!-- 分P / 选集 -->
                            <ListView
                                x:Name="EpisodeList"
                                MaxHeight="560"
                                IsItemClickEnabled="True"
                                ItemClick="EpisodeList_ItemClick"
                                SelectionMode="Single">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="pages:PlaylistEntry">
                                        <Grid ColumnSpacing="10" Padding="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border
                                                MinWidth="26"
                                                Height="26"
                                                Background="{StaticResource ControlFillColorDefaultBrush}"
                                                CornerRadius="13">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="11"
                                                    Text="{x:Bind IndexText}" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock
                                                    FontSize="13"
                                                    MaxLines="1"
                                                    Text="{x:Bind Title}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="{StaticResource TextFillColorSecondaryBrush}"
                                                    MaxLines="1"
                                                    Text="{x:Bind SubText}"
                                                    TextTrimming="CharacterEllipsis"
                                                    Visibility="{x:Bind SubText, Converter={StaticResource ObjectToVisibilityConverter}}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <!-- 评论 -->
                            <ListView
                                x:Name="CommentList"
                                MaxHeight="560"
                                SelectionMode="None"
                                Visibility="Collapsed">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0,6" />
                                        <Setter Property="MinHeight" Value="0" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="svc:CommentItem">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <PersonPicture
                                                Width="28"
                                                Height="28"
                                                VerticalAlignment="Top"
                                                DisplayName="{x:Bind UserName}"
                                                ProfilePicture="{x:Bind Avatar, Converter={StaticResource StringToImageSourceConverter}}" />

                                            <StackPanel Grid.Column="1" Spacing="3">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="{StaticResource TextFillColorSecondaryBrush}"
                                                        MaxLines="1"
                                                        Text="{x:Bind UserName}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <Border
                                                        Padding="4,0"
                                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                        CornerRadius="3"
                                                        Visibility="{x:Bind IsUp, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <TextBlock
                                                            FontSize="9"
                                                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                            Text="UP" />
                                                    </Border>
                                                    <Border
                                                        Padding="4,0"
                                                        Background="{StaticResource ControlFillColorDefaultBrush}"
                                                        CornerRadius="3"
                                                        Visibility="{x:Bind IsSticky, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <TextBlock FontSize="9" Text="置顶" />
                                                    </Border>
                                                </StackPanel>

                                                <TextBlock
                                                    FontSize="13"
                                                    IsTextSelectionEnabled="True"
                                                    MaxLines="8"
                                                    Text="{x:Bind Content}"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="Wrap" />

                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="{StaticResource TextFillColorSecondaryBrush}"
                                                        Text="{x:Bind PostDate}" />
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="{StaticResource TextFillColorSecondaryBrush}"
                                                        Text="{x:Bind LikeCountText}" />
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="{StaticResource TextFillColorSecondaryBrush}"
                                                        Text="{x:Bind SubCommentText}"
                                                        Visibility="{x:Bind ShowPlainSubText, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                </StackPanel>

                                                <!-- 展开 / 收起楼中楼 -->
                                                <Button
                                                    Margin="0,1,0,0"
                                                    Padding="8,2"
                                                    HorizontalAlignment="Left"
                                                    Background="{StaticResource ControlFillColorDefaultBrush}"
                                                    BorderThickness="0"
                                                    CornerRadius="4"
                                                    Visibility="{x:Bind CanExpand, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Click="ReplyToggle_Click">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <TextBlock
                                                            FontSize="11"
                                                            Text="{x:Bind ReplyToggleText, Mode=OneWay}" />
                                                        <FontIcon
                                                            FontSize="8"
                                                            Glyph="{x:Bind ReplyToggleGlyph, Mode=OneWay}" />
                                                    </StackPanel>
                                                </Button>

                                                <!-- 楼中楼内容 -->
                                                <StackPanel
                                                    Margin="0,4,0,0"
                                                    Spacing="6"
                                                    Visibility="{x:Bind IsExpanded, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <ItemsControl ItemsSource="{x:Bind Replies}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="svc:CommentItem">
                                                                <Grid
                                                                    Margin="0,0,0,8"
                                                                    ColumnSpacing="7"
                                                                    BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                                                                    BorderThickness="2,0,0,0"
                                                                    Padding="10,0,0,0">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>

                                                                    <PersonPicture
                                                                        Width="20"
                                                                        Height="20"
                                                                        VerticalAlignment="Top"
                                                                        DisplayName="{x:Bind UserName}"
                                                                        ProfilePicture="{x:Bind Avatar, Converter={StaticResource StringToImageSourceConverter}}" />

                                                                    <StackPanel Grid.Column="1" Spacing="2">
                                                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                                                            <TextBlock
                                                                                FontSize="11"
                                                                                Foreground="{StaticResource TextFillColorSecondaryBrush}"
                                                                                MaxLines="1"
                                                                                Text="{x:Bind UserName}"
                                                                                TextTrimming="CharacterEllipsis" />
                                                                            <Border
                                                                                Padding="4,0"
                                                                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                                                CornerRadius="3"
                                                                                Visibility="{x:Bind IsUp, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                                <TextBlock
                                                                                    FontSize="9"
                                                                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                                                    Text="UP" />
                                                                            </Border>
                                                                        </StackPanel>

                                                                        <TextBlock
                                                                            FontSize="12"
                                                                            IsTextSelectionEnabled="True"
                                                                            MaxLines="6"
                                                                            Text="{x:Bind Content}"
                                                                            TextTrimming="CharacterEllipsis"
                                                                            TextWrapping="Wrap" />

                                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                                            <TextBlock
                                                                                FontSize="10"
                                                                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                                                Text="{x:Bind ReplyToText}"
                                                                                Visibility="{x:Bind HasReplyTo, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                            <TextBlock
                                                                                FontSize="10"
                                                                                Foreground="{StaticResource TextFillColorSecondaryBrush}"
                                                                                Text="{x:Bind PostDate}" />
                                                                            <TextBlock
                                                                                FontSize="10"
                                                                                Foreground="{StaticResource TextFillColorSecondaryBrush}"
                                                                                Text="{x:Bind LikeCountText}" />
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <!-- 接口每个主楼只下发前 3 条，差额提示一下 -->
                                                    <TextBlock
                                                        FontSize="10"
                                                        Foreground="{StaticResource TextFillColorTertiaryBrush}"
                                                        Text="{x:Bind HiddenReplyText}"
                                                        Visibility="{x:Bind HasHiddenReplies, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <!-- 相关视频 -->
                            <ListView
                                x:Name="RelatedList"
                                MaxHeight="560"
                                IsItemClickEnabled="True"
                                ItemClick="RelatedList_ItemClick"
                                SelectionMode="Single"
                                Visibility="Collapsed">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0,5" />
                                        <Setter Property="MinHeight" Value="0" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="svc:RelatedVideoItem">
                                        <Grid ColumnSpacing="9">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="104" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Grid
                                                Height="59"
                                                Background="{StaticResource ControlFillColorDefaultBrush}"
                                                CornerRadius="5">
                                                <Image
                                                    Source="{x:Bind Cover, Converter={StaticResource StringToImageSourceConverter}}"
                                                    Stretch="UniformToFill" />
                                            </Grid>

                                            <StackPanel
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Spacing="3">
                                                <TextBlock
                                                    FontSize="12"
                                                    MaxLines="2"
                                                    Text="{x:Bind Title}"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="Wrap" />
                                                <TextBlock
                                                    FontSize="10"
                                                    Foreground="{StaticResource TextFillColorSecondaryBrush}"
                                                    MaxLines="1"
                                                    Text="{x:Bind SubText}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <!-- 空状态 / 提示 -->
                            <TextBlock
                                x:Name="SideEmptyHint"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Margin="0,24,0,0"
                                Foreground="{StaticResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                TextAlignment="Center"
                                TextWrapping="Wrap"
                                Visibility="Collapsed" />
                        </Grid>

                        <!-- 评论加载更多 -->
                        <Button
                            x:Name="LoadMoreCommentButton"
                            Grid.Row="3"
                            HorizontalAlignment="Center"
                            Padding="14,5"
                            FontSize="12"
                            Visibility="Collapsed"
                            Click="LoadMoreCommentButton_Click"
                            Content="加载更多评论" />
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
