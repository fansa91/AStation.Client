<Page
    x:Class="AStation_Client.Pages.ChannelPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Grid Padding="24,16,24,16" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource TitleTextBlockStyle}" Text="频道分区" />

        <StackPanel Grid.Row="1" Spacing="4">
            <TextBlock Text="热门频道" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock
                x:Name="HintText"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{StaticResource TextFillColorSecondaryBrush}"
                Visibility="Collapsed" />
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
            <ItemsRepeater x:Name="ChannelGrid">
                <ItemsRepeater.Layout>
                    <UniformGridLayout
                        MinItemWidth="150"
                        MinItemHeight="88"
                        MinColumnSpacing="12"
                        MinRowSpacing="12"
                        ItemsStretch="Fill" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate>
                        <Button
                            Height="88"
                            HorizontalAlignment="Stretch"
                            Content="{Binding Name}"
                            FontSize="15"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Style="{StaticResource ChannelCardButtonStyle}" />
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>
    </Grid>
</Page>
