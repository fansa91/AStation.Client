<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- 单文件发布：命令行工具解压就是一个 exe（示例配置仍作为独立文件随包），
         不再随包携带上百个 dll；框架依赖 / 自包含两种发布方式都适用 -->
    <PublishSingleFile Condition="'$(PublishSingleFile)' == ''">true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <!-- 锁定 NuGet 依赖（packages.lock.json 入库），CI 以 locked 模式还原，保证可复现 -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>

    <!-- 声明发布用的 RID：发布链路带 RID 的锁定还原要求 lock 里有 win-x64 段。
         声明后，无 RID 的本地还原也会生成同样的段，lock 不会两边来回改写。 -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>

    <AssemblyName>AStation.Client.Console</AssemblyName>
    <!-- 命名空间不用 AStation_Client.Console：类名叫 Console 的命名空间会让
         System.Console 解析成命名空间，代码里所有 Console.Write 都会编译不过。
         所以根命名空间收在 ...Cli 下，程序集名仍然是 AStation.Client.Console。 -->
    <RootNamespace>AStation_Client.Cli</RootNamespace>

    <Description>AcFun 接口命令行工具 / API 使用示例</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AStation.Client.Core\AStation.Client.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 示例配置文件随构建 / 发布一起拷到输出目录，用户复制改名成
         AStation.Client.Console.config 即可生效（.example 后缀不会被自动加载） -->
    <None Update="AStation.Client.Console.config.example"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
