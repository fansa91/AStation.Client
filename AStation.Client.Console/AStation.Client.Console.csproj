<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <AssemblyName>AStation.Client.Console</AssemblyName>
    <!-- 命名空间不用 AStation_Client.Console：类名叫 Console 的命名空间会让
         System.Console 解析成命名空间，代码里所有 Console.Write 都会编译不过。
         所以根命名空间收在 ...Cli 下，程序集名仍然是 AStation.Client.Console。 -->
    <RootNamespace>AStation_Client.Cli</RootNamespace>

    <Description>AcFun 接口命令行工具 / API 使用示例</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AStation.Client.Core\AStation.Client.Core.csproj" />
  </ItemGroup>

</Project>
