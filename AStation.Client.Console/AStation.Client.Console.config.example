# =============================================================================
#  AStation.Client.Console 示例配置文件
# =============================================================================
#
#  怎么用：
#    1. 复制本文件，改名为  AStation.Client.Console.config
#       （去掉末尾的 .example 才能被自动识别）；
#    2. 放到 exe 旁边（程序目录），或当前工作目录，即默认生效；
#    3. 也可以放到任意位置，用  --config-file <路径>  指定；
#       临时不想用配置就加  --no-config。
#
#  格式（同 BBDown.config）：
#    · 一行一个参数；
#    · 需要值的选项，把值单独写在「下一行」——所以值里带空格、带引号都不用转义；
#    · # 或 // 开头的行是注释，空行忽略；
#    · 只放「选项」，不要写命令名和裸参数（写了会在 stderr 提示被忽略）；
#    · 配置里的参数排在命令行参数「之前」，命令行上再写一次就能覆盖它。
#
#  两个容易踩的点：
#    · 带值的选项必须「选项行 + 值行」成对注释或成对放开。只注释掉选项行、
#      把值留在外面，那个值会变成裸参数被忽略（配置里会给出提示）。
#    · 别用单字母别名。别名在多命令间会撞车（-p 既可能是 password，也可能是
#      period / path；-u 既可能是 username，也可能是 url），配置里一律写全名。
#
#  下面所有选项默认都是注释掉的，按需删掉行首的 # 即可生效。
#  想看当前到底解析出了什么：AStation.Client.Console.exe config
# =============================================================================


# ────────────────────────────── 通用：输出与列表 ──────────────────────────────

# 所有命令默认输出 JSON（方便接 jq / 脚本；诊断信息走 stderr，不污染 stdout）
#--json

# 显示未解析的原始正文（评论 / 弹幕 / UBB）
#--raw

# 列表类命令的默认条数（search 最多 30；rank / live / bangumi 最多 50）
#--limit
#20


# ────────────────────────────── 搜索 / 排行榜 ──────────────────────────────

# 搜索默认排序：1 综合（默认）/ 2 最多播放 / 5 最新发布
#--sort
#2

# 排行榜默认一级频道 id（0 = 全站；其他频道 id 见 rank 命令输出的 channelId）
#--channel
#0

# 排行榜默认周期：today 日榜（默认）/ 3d 三日榜 / week 周榜
#--period
#week


# ────────────────────────────── 评论 / 弹幕 ──────────────────────────────

# 评论默认页码
#--page
#1

# 评论 / 取流 / 收藏的资源类型：3 = 视频评论（默认）、2 = 番剧评论
# 注意各命令对这个值的语义不同，按命令理解（详见 README）
#--type
#3

# 直播间弹幕的监听时长（秒）
#--seconds
#20


# ────────────────────────────── 播放 / 下载 ──────────────────────────────

# 下载默认清晰度：best（默认，最高档）/ 1080P / 720P / 540P / 360P
# 也可以只写数字，如 720
#--quality
#720

# 下载输出文件名（不写则按视频标题自动命名）
#--out
#out.ts

# 下载后调用 ffmpeg 无损转封装成 mp4
#--mp4

# 只要 H.264 清单，不要 H.265（HEVC）
#--h264

# 指定分P 的 videoId（是 video 命令最后一列那个，不是 acId）
#--video
#12345678

# 番剧播放授权 mkey
#--mkey
#xxxxxxxx


# ────────────────────────────── 登录 / 账号 ──────────────────────────────

# 命令行登录用的账号与密码（必须是手机号或邮箱，老式用户名会被服务端拒绝）
# 注意：这里是明文，别把这行留在会被人看到的配置里；交互式登录可以不写
#--username
#13800000000
#--password
#your-password

# 复用指定路径的 Cookie 文件
# （默认读 %LOCALAPPDATA%\AStation.Client\cli-cookies.json）
#--cookies
#C:\Tools\ac-cookies.json


# ────────────────────────────── 收藏 / 历史 ──────────────────────────────

# 收藏默认分类：douga 视频（默认）/ bangumi 番剧 / album 专辑 / article 文章
#--type
#douga

# 收藏游标分页：首屏必须写 0，之后用上一页返回的 cursor
#--cursor
#0

# 收藏每页条数
#--count
#20

# 播放历史每页条数与页码
#--size
#20
#--page
#1

# 播放历史只要视频（不含番剧）
#--no-bangumi


# =============================================================================
#  组合示例：想整套用就取消对应段落的注释
#  同一选项在多段里重复出现时，以「最后一段」为准（后写的覆盖先写的）
# =============================================================================

# ── 场景 A：下载党 —— 默认 720P、转 mp4、只要 H.264 ──
#--quality
#720
#--mp4
#--h264

# ── 场景 B：接口调试 —— 默认输出 JSON，列表一次给够 30 条 ──
#--json
#--limit
#30

# ── 场景 C：只关心视频观看历史 —— 10 条一页、排除番剧 ──
#--size
#10
#--no-bangumi
