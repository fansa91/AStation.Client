<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AStation_Client.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:AStation_Client"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="AStation.Client">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="ShellRoot">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleBarRow" Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            自定义标题栏
              [汉堡] [图标+名称] [后退] [弹性搜索] [置顶·账号] [系统按钮让位列]
            系统按钮让位用第 6 列宽度承担，不再改 Tail 的 Margin，
            避免最大化 / 还原时右侧元素来回跳。
        -->
        <Grid
            x:Name="AppTitleBar"
            Height="48"
            VerticalAlignment="Top"
            Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="TitleBarInsetColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <!-- 汉堡：NavigationView 自带的 toggle 已关闭，这里自己画一个 -->
            <Button
                x:Name="PaneToggleButton"
                Grid.Column="0"
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                AutomationProperties.Name="导航"
                Click="PaneToggleButton_Click"
                Style="{StaticResource IconSubtleButtonStyle}"
                ToolTipService.ToolTip="展开 / 收起导航">
                <FontIcon FontSize="15" Glyph="&#xE700;" />
            </Button>

            <!-- 应用图标 + 名称（窄窗口隐藏名称） -->
            <StackPanel
                x:Name="AppBrand"
                Grid.Column="1"
                Margin="4,0,0,0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <ImageIcon Width="18" Height="18" Source="Assets/AppIcon.ico" />
                <TextBlock
                    x:Name="AppBrandText"
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    Text="AStation" />
            </StackPanel>

            <!-- 后退 -->
            <Button
                x:Name="BackButton"
                Grid.Column="2"
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                AutomationProperties.Name="后退"
                Click="BackButton_Click"
                IsEnabled="False"
                Style="{StaticResource IconSubtleButtonStyle}"
                ToolTipService.ToolTip="后退">
                <FontIcon FontSize="14" Glyph="&#xE72B;" />
            </Button>

            <!-- 搜索：弹性宽度，窄窗口收成图标 -->
            <Grid
                Grid.Column="3"
                Margin="12,0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center">
                <AutoSuggestBox
                    x:Name="SearchBox"
                    MaxWidth="520"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    PlaceholderText="搜索视频、用户、番剧"
                    QueryIcon="Find"
                    QuerySubmitted="SearchBox_QuerySubmitted"
                    TextChanged="SearchBox_TextChanged" />
                <Button
                    x:Name="SearchIconButton"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="搜索"
                    Click="SearchIconButton_Click"
                    Style="{StaticResource IconSubtleButtonStyle}"
                    ToolTipService.ToolTip="搜索"
                    Visibility="Collapsed">
                    <FontIcon FontSize="15" Glyph="&#xE721;" />
                </Button>
            </Grid>

            <!-- 尾部操作 -->
            <StackPanel
                Grid.Column="4"
                Margin="4,0,12,0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="2">
                <Button
                    x:Name="PinButton"
                    AutomationProperties.Name="窗口置顶"
                    Click="PinButton_Click"
                    Style="{StaticResource IconSubtleButtonStyle}"
                    ToolTipService.ToolTip="窗口置顶">
                    <FontIcon FontSize="14" Glyph="&#xE718;" />
                </Button>
                <Button
                    x:Name="AccountButton"
                    AutomationProperties.Name="账号"
                    Click="AccountButton_Click"
                    Style="{StaticResource IconSubtleButtonStyle}"
                    ToolTipService.ToolTip="账号 / 登录">
                    <FontIcon x:Name="AccountIcon" FontSize="14" Glyph="&#xE77B;" />
                </Button>
            </StackPanel>

            <!-- 系统窗口按钮（最小化/最大化/关闭）让位 -->
            <Border Grid.Column="5" />
        </Grid>

        <!-- 主内容区 -->
        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            ItemInvoked="NavView_ItemInvoked"
            SelectionChanged="NavView_SelectionChanged"
            Style="{StaticResource NavigationViewStyle}">
            <NavigationView.MenuItems>
                <!-- 主导航项：图标全部为自定义矢量路径，语义互不重复 -->
                <NavigationViewItem
                    x:Name="NavItemHome"
                    Content="首页"
                    IsSelected="True"
                    Tag="home">
                    <NavigationViewItem.Icon>
                        <PathIcon Data="M12 2.9 2 11h3v10h5.3v-6.1h3.4V21H19V11h3z" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="NavItemChannel"
                    Content="频道"
                    Tag="channel">
                    <NavigationViewItem.Icon>
                        <PathIcon Data="M3 3h8v8H3zM13 3h8v8h-8zM3 13h8v8H3zM13 13h8v8h-8z" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="NavItemRank"
                    Content="排行榜"
                    Tag="rank">
                    <NavigationViewItem.Icon>
                        <PathIcon Data="M3.5 14.5h4.2V21H3.5zM9.9 9h4.2v12H9.9zM16.3 3.5h4.2V21h-4.2z" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="NavItemBangumi"
                    Content="番剧"
                    Tag="bangumi">
                    <NavigationViewItem.Icon>
                        <PathIcon Data="M2.5 4h19v12.2h-19zM8.6 17.9h6.8V20H8.6z" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="NavItemLive"
                    Content="直播"
                    Tag="live">
                    <NavigationViewItem.Icon>
                        <PathIcon Data="M2.5 6.6h11.2v10.8H2.5zM14.9 10.3 21.5 6.2v11.6l-6.6-4.1z" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <!-- 底部：账号区 + 设置 + 关于（账号区与标题栏账号按钮共享状态） -->
            <NavigationView.FooterMenuItems>
                <NavigationViewItem
                    x:Name="NavItemAccount"
                    Content="登录"
                    SelectsOnInvoked="False"
                    Tag="account">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE77B;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="NavItemSettings"
                    Content="设置"
                    Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="关于" Tag="about">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE897;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <!-- 内容 + 覆盖层 -->
            <Grid x:Name="MainGrid">
                <!-- 限宽宿主：≥1600 时内容居中，避免超宽屏卡片被拉散 -->
                <Grid x:Name="ContentHost" HorizontalAlignment="Stretch">
                    <Frame x:Name="MainFrame" />
                </Grid>
            </Grid>
        </NavigationView>

        <!-- 覆盖层壳：scrim + 卡片。挂在 ShellRoot 上（不是 NavView 里），
             否则 NavView.IsEnabled=false 会把覆盖层里的控件一起变灰 -->
        <Grid
            x:Name="OverlayHost"
            Grid.RowSpan="2"
            Canvas.ZIndex="10"
            Visibility="Collapsed">
            <Grid.KeyboardAccelerators>
                <KeyboardAccelerator Invoked="OverlayEscape_Invoked" Key="Escape" />
            </Grid.KeyboardAccelerators>

            <Border
                x:Name="OverlayScrim"
                Background="{ThemeResource AppScrimBrush}"
                Tapped="OverlayScrim_Tapped" />

            <Border
                x:Name="OverlayCard"
                MaxWidth="880"
                MaxHeight="760"
                MinHeight="240"
                Margin="24"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Frame x:Name="OverlayFrame" />
            </Border>
        </Grid>
    </Grid>
</Window>
