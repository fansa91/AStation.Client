<Window
    x:Class="AStation_Client.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:AStation_Client"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="AStation.Client">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="ShellRoot">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleBarRow" Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 自定义标题栏（参考 Bili.Copilot AppTitleBar）
             注意：右侧要给系统的最小化/最大化/关闭按钮留出位置，否则账号、置顶按钮会被压在窗口按钮下面 -->
        <Grid
            x:Name="AppTitleBar"
            Height="48"
            VerticalAlignment="Top"
            Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 应用图标 + 标题 -->
            <StackPanel
                Grid.Column="0"
                Orientation="Horizontal"
                VerticalAlignment="Center"
                Spacing="8"
                Margin="16,0,0,0">
                <ImageIcon Source="Assets/AppIcon.ico" Width="18" Height="18" />
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="AStation.Client"
                    FontWeight="SemiBold" />
            </StackPanel>

            <!-- 搜索框（居中，宽度自适应，两侧留白，不与右侧按钮挤在一起） -->
            <AutoSuggestBox
                Grid.Column="1"
                x:Name="SearchBox"
                MinWidth="220"
                MaxWidth="520"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                PlaceholderText="搜索视频、用户、番剧"
                QueryIcon="Find"
                QuerySubmitted="SearchBox_QuerySubmitted"
                TextChanged="SearchBox_TextChanged" />

            <!-- 尾部：置顶 + 账号。Margin 的右侧会在代码里按系统窗口按钮宽度动态让位 -->
            <StackPanel
                x:Name="TitleBarTail"
                Grid.Column="2"
                Orientation="Horizontal"
                VerticalAlignment="Center"
                Spacing="4"
                Margin="12,0,16,0">
                <Button
                    x:Name="PinButton"
                    ToolTipService.ToolTip="窗口置顶"
                    Style="{StaticResource AppButtonStyle}"
                    Click="PinButton_Click">
                    <SymbolIcon Symbol="Pin" />
                </Button>
                <Button
                    x:Name="AccountButton"
                    ToolTipService.ToolTip="账号 / 登录"
                    Style="{StaticResource AppButtonStyle}"
                    Click="AccountButton_Click">
                    <SymbolIcon Symbol="Contact" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- 主内容区：NavigationView + 双 Frame -->
        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            IsPaneToggleButtonVisible="True"
            IsPaneOpen="True"
            OpenPaneLength="188"
            PaneDisplayMode="Left"
            SelectionChanged="NavView_SelectionChanged"
            Style="{StaticResource NavigationViewStyle}">
            <NavigationView.MenuItems>
                <!-- 主导航项：图标全部为自定义矢量路径，语义互不重复 -->
                <NavigationViewItem
                    x:Name="NavItemHome"
                    Content="首页"
                    Tag="home"
                    IsSelected="True">
                    <NavigationViewItem.Icon>
                        <!-- 房子 -->
                        <PathIcon Data="M12 2.9 2 11h3v10h5.3v-6.1h3.4V21H19V11h3z" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="NavItemChannel"
                    Content="频道"
                    Tag="channel">
                    <NavigationViewItem.Icon>
                        <!-- 四宫格：分区/频道 -->
                        <PathIcon Data="M3 3h8v8H3zM13 3h8v8h-8zM3 13h8v8H3zM13 13h8v8h-8z" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="NavItemRank"
                    Content="排行榜"
                    Tag="rank">
                    <NavigationViewItem.Icon>
                        <!-- 递增柱状图：榜单 -->
                        <PathIcon Data="M3.5 14.5h4.2V21H3.5zM9.9 9h4.2v12H9.9zM16.3 3.5h4.2V21h-4.2z" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="NavItemBangumi"
                    Content="番剧"
                    Tag="bangumi">
                    <NavigationViewItem.Icon>
                        <!-- 电视：追番 -->
                        <PathIcon Data="M2.5 4h19v12.2h-19zM8.6 17.9h6.8V20H8.6z" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="NavItemLive"
                    Content="直播"
                    Tag="live">
                    <NavigationViewItem.Icon>
                        <!-- 摄像机：直播 -->
                        <PathIcon Data="M2.5 6.6h11.2v10.8H2.5zM14.9 10.3 21.5 6.2v11.6l-6.6-4.1z" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemSeparator />
                <NavigationViewItem
                    x:Name="NavItemLogin"
                    Content="登录"
                    Tag="login">
                    <NavigationViewItem.Icon>
                        <!-- 人像：账号 -->
                        <PathIcon Data="M12 2.9a4.2 4.2 0 1 1 0 8.4 4.2 4.2 0 0 1 0-8.4zM4 20.6c0-3.6 3.6-5.9 8-5.9s8 2.3 8 5.9v.4H4z" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="NavItemSettings"
                    Content="设置"
                    Tag="settings"
                    Icon="Setting" />
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="关于" Tag="about" Icon="Help" />
            </NavigationView.FooterMenuItems>

            <!-- 双 Frame：MainFrame 主页面，OverlayFrame 覆盖层页面 -->
            <Grid x:Name="MainGrid">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="WindowStates">
                        <VisualState x:Name="WideState">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="{StaticResource AppWindowNarrowMinWidth}" />
                            </VisualState.StateTriggers>
                        </VisualState>
                        <VisualState x:Name="NarrowState">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="0" />
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="SearchBox.MinWidth" Value="120" />
                                <Setter Target="SearchBox.PlaceholderText" Value="" />
                                <Setter Target="AppTitleBar.Padding" Value="0" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                    <VisualStateGroup x:Name="OverlayStates">
                        <VisualState x:Name="OverlayClosed" />
                        <VisualState x:Name="OverlayOpen">
                            <VisualState.Setters>
                                <Setter Target="MainFrame.Opacity" Value="0.4" />
                                <Setter Target="NavView.IsEnabled" Value="False" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>

                <Grid>
                    <Frame x:Name="MainFrame" />
                    <Frame
                        x:Name="OverlayFrame"
                        Visibility="Collapsed"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch" />
                </Grid>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
