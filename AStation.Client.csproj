<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>AStation_Client</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="Exists('Assets\AppIcon.ico')">Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <PublishProfile Condition="Exists('Properties\PublishProfiles\win-$(Platform).pubxml')">win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>false</EnableMsixTooling>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- 版本号默认值（README 里写的 0.1 对应这里）。
         CI 按 git tag 覆盖：-p:Version=<tag 去掉 v> -->
    <Version>0.1.2</Version>
    <!-- 本地构建的 ProductVersion 不要带 +commitHash 尾巴，发布包里版本号干净一些 -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AssemblyTitle>AStation.Client</AssemblyTitle>
    <Product>AStation.Client</Product>
    <Description>AcFun 第三方桌面客户端</Description>

    <!-- .NET 运行时自包含 -->
    <SelfContained>true</SelfContained>

    <!-- 非打包（unpackaged）应用：可直接用 exe 启动，无需 MSIX 身份 -->
    <WindowsPackageType>None</WindowsPackageType>

    <!-- Windows App SDK 运行时自包含：把 WinAppRuntime DLL 复制到输出目录，
         无需在系统上预装 Windows App Runtime 框架包 -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <DefaultItemExcludes>$(DefaultItemExcludes);AStation.Client.Core\**;AStation.Client.Tests\**</DefaultItemExcludes>

    <!-- FFmpegInteropX 的 nuget 包会带一个 winmd，默认会让 CsWinRT 重新生成一次投影
         （cswinrt.exe 要求本机注册过 Windows SDK，这里没有，构建日志会报 Could not find the Windows SDK）。
         它本身已经提供了预生成的投影程序集 FFmpegInteropX.DotNet.dll，直接用即可。 -->
    <CsWinRTGenerateProjection>false</CsWinRTGenerateProjection>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-48_altform-lightunplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\AppIcon.ico" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
    <!-- 1024 母版只留在仓库里做设计源文件，不随包分发 -->
    <Content Remove="Assets\AppIcon-1024.png" />
    <!-- Content 默认只进 build 输出（CopyToOutputDirectory），不会进 publish 目录。
         运行时要按相对路径读 Assets/AppIcon.ico（窗口图标、标题栏图标），
         发布包漏掉这个目录会导致图标丢失，所以显式声明跟着发布走。 -->
    <Content Update="Assets\*.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Update="Assets\*.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    WinUI 3 的 XAML 资源索引 <AssemblyName>.pri 由 XAML 编译器生成在 build 输出目录，
    但 dotnet publish 不会把它复制到发布目录。unpackaged 应用缺了它，
    XAML 资源查找会在启动阶段失败，进程直接以 0xc000027b（E_FAIL）退出，连窗口都出不来。
    实测：publish 出目录里只有 Microsoft.UI.Xaml 等框架自带的 .pri，没有本项目的那个。
  -->
  <Target Name="CopyProjectPriToPublishDir" AfterTargets="Publish" Condition="Exists('$(TargetDir)$(AssemblyName).pri')">
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).pri" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix"/>
  </ItemGroup>

  <!--
    Microsoft.Windows.SDK.BuildTools.WinApp adds first-class support for
    `dotnet run` on packaged WinUI apps: it hooks the .NET CLI Run target to
    register a debug identity via the winapp CLI and launch the app with
    package identity (AUMID).
    Set <EnableWinAppRunSupport>false</EnableWinAppRunSupport> in a
    <PropertyGroup> above to opt out.
  -->
  <ItemGroup>
    <ProjectReference Include="AStation.Client.Core/AStation.Client.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="*" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="*" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" Version="*" />
    <!-- 直播拉流：AcFun 直播只提供 FLV，Windows Media Foundation 不支持 FLV，
         用 FFmpegInteropX 把 FLV 解码后交给 MediaPlayer -->
    <PackageReference Include="FFmpegInteropX" Version="2.1.0.81200" />
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <!-- WinUI 3 不支持 IL 裁剪（XAML 类型靠反射解析，被裁掉会启动即崩），
         Release 下也必须是 False；CI 的 release workflow 会显式再传一次防回归 -->
    <PublishTrimmed>False</PublishTrimmed>
  </PropertyGroup>
</Project>
